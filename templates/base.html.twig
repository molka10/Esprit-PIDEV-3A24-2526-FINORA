            border: 1px solid transparent !important;
            transition: all 0.2s ease;
        }
        .header-search-input:focus {
            background: #fff !important;
            border-color: #7c3aed !important;
            box-shadow: 0 0 0 3px rgba(124, 58, 237, 0.1) !important;
        }
        body.no-sidebar .header-search-container {
            display: none !important;
        }
        .btn-round-light {
            background: #f1f5f9;
            width: 38px;
            height: 38px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            transition: all 0.2s ease;
        }
        .btn-round-light:hover {
            background: #e2e8f0;
            color: #7c3aed;
        }

        /* --- Layout & Utilities --- */
        body {
            padding-top: 105px; /* Reduced from 140px */
            background: #f8fafc;
            overflow-x: hidden;
            scroll-behavior: smooth;
        }
        body.no-sidebar {
            padding-top: 0;
        }
