        .footer-purple .nav-link:hover { color: #ffffff !important; transform: translateX(5px); }
        .footer-purple h5 { color: #ffffff !important; font-weight: 700; }
        .footer-purple .text-body-secondary { color: rgba(255, 255, 255, 0.5) !important; }
        .footer-purple hr { border-color: rgba(255, 255, 255, 0.1); }
        
