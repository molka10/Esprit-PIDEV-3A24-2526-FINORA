<body class="{% if app.request.attributes.get('_route') in ['app_login', 'app_register'] %}no-sidebar{% endif %} 
             {% set route = app.request.attributes.get('_route') %}
             {% if route in ['app_home', 'app_formation_home', 'app_formations', 'public_centres_map'] or route starts with 'app_formation' or route starts with 'app_lesson' %}is-formation-page{% endif %}">

{% if app.request.attributes.get('_route') not in ['app_login', 'app_register'] %}
<!-- Sidebar Wrapper -->
<div class="sidebar-wrapper shadow-lg" style="left: 0 !important;">
    <div class="sidebar-header">
        <div class="d-flex align-items-center">
            <img src="{{ asset('assets/images/logo-finora.webp') }}" alt="FINORA" style="height: 40px;">
        </div>
        <button class="btn btn-sm btn-light btn-round mb-0" id="sidebarClose"><i class="bi bi-x-lg"></i></button>
    </div>
    
    <div class="sidebar-content custom-scrollbar p-3">
        <!-- User Profile Quick Info -->
        {% if app.user %}
        <div class="d-flex align-items-center p-3 mb-4 rounded-4 bg-primary bg-opacity-10 border border-primary border-opacity-10">
            <div class="avatar avatar-md me-3">
                {% if app.user.image %}
                    <img class="avatar-img rounded-circle border border-2 border-white" src="{{ asset('uploads/' ~ app.user.image) }}" alt="avatar" style="width: 45px; height: 45px; object-fit: cover;">
                {% else %}
                    <img class="avatar-img rounded-circle border border-2 border-white" src="https://ui-avatars.com/api/?name={{ app.user.username }}&background=7c3aed&color=fff" alt="avatar" style="width: 45px;">
                {% endif %}
            </div>
            <div class="overflow-hidden">
                <h6 class="mb-0 text-truncate">{{ app.user.username }}</h6>
                <p class="small text-muted mb-0 text-truncate">{{ app.user.email }}</p>
            </div>
        </div>
