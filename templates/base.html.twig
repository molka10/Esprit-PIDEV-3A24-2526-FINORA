            min-height: 60vh;
            display: flex;
            align-items: center;
            position: relative;
            z-index: 1;
        }
        .glass-card {
            background: rgba(255, 255, 255, 0.7);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.3);
            border-radius: 20px;
            transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .glass-card:hover {
            transform: translateY(-8px);
            background: rgba(255, 255, 255, 0.9);
            border-color: var(--finora-purple);
            box-shadow: 0 20px 40px rgba(124, 58, 237, 0.15);
        }
        
        /* Premium Buttons */
        .btn-premium {
            background: linear-gradient(135deg, #7c3aed 0%, #6d28d9 100%);
            color: white;
            border: none;
            box-shadow: 0 4px 15px rgba(124, 58, 237, 0.3);
            transition: all 0.3s ease;
        }
        .btn-premium:hover {
            transform: scale(1.03);
            box-shadow: 0 8px 25px rgba(124, 58, 237, 0.4);
            color: white;
        }
        .explore-icon {
            width: 70px;
            height: 70px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 20px;
            margin-bottom: 1.5rem;
            font-size: 2rem;
            background: rgba(124, 58, 237, 0.15);
            color: #a78bfa;
        }
        .animate-float {
            animation: float 6s ease-in-out infinite;
        }
        @keyframes float {
            0% { transform: translateY(0px); }
            50% { transform: translateY(-20px); }
            100% { transform: translateY(0px); }
        }
        .btn-premium {
            background: white;
            color: var(--finora-purple);
            border: none;
            padding: 1rem 2.5rem;
            font-weight: 700;
            border-radius: 50px;
            box-shadow: 0 10px 20px rgba(0,0,0,0.1);
            transition: all 0.3s ease;
        }
        .btn-premium:hover {
            transform: scale(1.05) translateY(-2px);
            background: #f3f4f6;
            box-shadow: 0 15px 30px rgba(124, 58, 237, 0.3);
        }
    	/* Global Anchor Fix for Sticky Navbars */
	[id] {
		scroll-margin-top: 160px; /* Offset for dual navbars */
	}

    /* Sidebar Variables */
    :root {
        --sidebar-width: 260px; /* Slightly narrower for better fit */
        --sidebar-bg: rgba(255, 255, 255, 0.9);
        --sidebar-blur: 25px;
        --sidebar-transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    }

    [data-bs-theme='dark'] {
        --sidebar-bg: rgba(15, 23, 42, 0.85);
    }

    /* Sidebar Structure */
    .sidebar-wrapper {
        position: fixed;
        top: 0;
        left: 0;
        height: 100vh;
        width: var(--sidebar-width);
        background: var(--sidebar-bg);
        backdrop-filter: blur(var(--sidebar-blur));
        -webkit-backdrop-filter: blur(var(--sidebar-blur));
        z-index: 2000;
        transform: translateX(-105%); /* Ensure it's fully hidden */
        transition: var(--sidebar-transition);
        border-right: 1px solid rgba(124, 58, 237, 0.1);
        display: flex;
        flex-direction: column;
        box-shadow: 20px 0 60px rgba(0, 0, 0, 0.1);
    }

    body.sidebar-open .sidebar-wrapper {
        transform: translateX(0);
    }

    .sidebar-header {
        padding: 1.25rem 1.5rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: rgba(124, 58, 237, 0.03);
    }

    .sidebar-content {
        flex: 1;
        overflow-y: auto;
        padding: 1.5rem;
    }

    /* Sidebar Nav Links */
    .sidebar-nav-link {
        display: flex;
        align-items: center;
        padding: 0.85rem 1.25rem;
        margin-bottom: 0.4rem;
        border-radius: 14px;
        color: inherit;
        text-decoration: none;
        font-weight: 500;
        transition: all 0.25s ease;
        gap: 15px;
        font-size: 0.95rem;
    }

    .sidebar-nav-link i {
        font-size: 1.3rem;
        color: var(--finora-purple);
        opacity: 0.85;
    }

    .sidebar-nav-link:hover {
        background: rgba(124, 58, 237, 0.08);
        color: var(--finora-purple);
        transform: translateX(8px);
    }

    .sidebar-nav-link.active {
        background: var(--finora-gradient);
        color: white !important;
        box-shadow: 0 4px 15px rgba(124, 58, 237, 0.3);
    }
    .sidebar-nav-link.active i { color: white; opacity: 1; }

    /* Accordion Customization */
    .sidebar-content .collapse {
        transition: all 0.3s ease;
    }

    /* Overlay */
    .sidebar-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background: rgba(0, 0, 0, 0.3);
        backdrop-filter: blur(4px);
        z-index: 1999;
        opacity: 0;
        visibility: hidden;
        transition: var(--sidebar-transition);
    }

    body.sidebar-open .sidebar-overlay {
        opacity: 1;
        visibility: visible;
    }

    /* Desktop Push Logic */
    @media (min-width: 1200px) {
        body.sidebar-open:not(.no-sidebar) {
            padding-left: var(--sidebar-width);
            transition: padding-left 0.5s cubic-bezier(0.16, 1, 0.3, 1);
        }
        body.sidebar-open:not(.no-sidebar) .fixed-top {
            width: calc(100% - var(--sidebar-width));
            left: var(--sidebar-width);
            transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
        }
        /* When open, remove overlay on desktop for 'dont block view' */
        body.sidebar-open:not(.no-sidebar) .sidebar-overlay {
            display: none;
        }
    }
    
    /* Strictly contain the width for a premium centered look */
    .container {
        max-width: 1240px !important; 
        margin-left: auto !important;
        margin-right: auto !important;
    }
    
    /* Animation Tokens */
    @keyframes fadeInUp {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
    }
    .animate-in {
        animation: fadeInUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .sidebar-toggle-btn {
        background: rgba(124, 58, 237, 0.05);
        border: 1px solid rgba(124, 58, 237, 0.1);
        font-size: 1.4rem;
        padding: 0.5rem;
        margin-right: 1.25rem;
        border-radius: 12px;
        transition: all 0.2s;
        display: flex;
        align-items: center;
        color: var(--finora-purple);
    }

    .sidebar-toggle-btn:hover {
        background: rgba(124, 58, 237, 0.15);
        transform: scale(1.05);
    }
</style>

