            position: absolute;
            right: 70px;
            background: #1e1b4b;
            color: white;
            padding: 6px 12px;
            border-radius: 8px;
            font-size: 12px;
            font-weight: bold;
            opacity: 0;
            transform: translateX(10px);
            transition: all 0.3s;
            pointer-events: none;
        }
        .fab-guide:hover::after {
            opacity: 1;
            transform: translateX(0);
        }

        /* --- Finora Pro Guide Modal --- */
        .guide-modal .modal-content {
            border-radius: 30px;
            border: none;
            overflow: hidden;
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(15px);
        }
