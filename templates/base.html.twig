    ]
};

function startFinoraGuide() {
    // 1. Check if we have page-specific hotspots
    const currentPath = window.location.pathname.toLowerCase();
    let foundContext = null;
    
    // Remove existing hotspots
    document.querySelectorAll('.magic-hotspot').forEach(el => el.remove());

    // Better matching logic
    for (const route in guideConfig) {
        if (currentPath.includes(route) || (route === 'home' && (currentPath === '/' || currentPath === ''))) {
            foundContext = guideConfig[route];
            break;
        }
    }

    if (foundContext) {
        let foundAny = false;
        
        foundContext.forEach(point => {
            const el = document.getElementById(point.id);
            if (el) {
                foundAny = true;
                const rect = el.getBoundingClientRect();
                const hotspot = document.createElement('div');
                hotspot.className = 'magic-hotspot';
                hotspot.style.top = (rect.top + window.scrollY - 12) + 'px';
                hotspot.style.left = (rect.left + window.scrollX - 12) + 'px';
                hotspot.innerHTML = '<i class="fas fa-info"></i><div class="hotspot-tooltip">' + point.text + '</div>';
                document.body.appendChild(hotspot);
            }
        });

        if (foundAny) {
            Swal.fire({
                title: 'Guide Finora Actif',
                text: 'Explorez la page en survolant les points oranges.',
                icon: 'info',
                timer: 3000,
                showConfirmButton: false,
                toast: true,
                position: 'top-end'
            });
            return;
        }
    }
    
    Swal.fire({
        title: 'Guide Indisponible',
        text: 'Aucun point d\'information spécifique n\'est disponible pour cette section.',
        icon: 'warning',
        timer: 2000,
        showConfirmButton: false
    });
}

document.addEventListener('DOMContentLoaded', function() {
    console.log("Finora Guide System Ready (Manual Only)");
});
</script>
