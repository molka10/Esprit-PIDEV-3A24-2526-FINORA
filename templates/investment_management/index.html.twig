{% extends 'base.html.twig' %}

{% block title %}Suivi de Portefeuille - FINORA{% endblock %}

{% block breadcrumb %}Suivi de Portefeuille{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        :root {
            --finora-purple-light: #ede9fe;
            --finora-purple: #7c3aed;
            --finora-purple-dark: #4c1d95;
            --finora-indigo: #4338ca;
            --emerald-bg: #064e3b;
            --emerald-light: #34d399;
            --glass-bg: rgba(255, 255, 255, 0.9);
            --glass-border: rgba(124, 58, 237, 0.15);
        }

        /* --- PREMIUM MANAGEMENT HERO --- */
        .hero-canvas-management {
            position: relative;
            z-index: 1;
        }

        .mesh-bg-emerald {
            position: absolute;
            top: 0; left: 0; right: 0; bottom: 0;
            background: 
                radial-gradient(at 0% 0%, rgba(52, 211, 153, 0.2) 0px, transparent 50%),
                radial-gradient(at 100% 0%, rgba(16, 185, 129, 0.1) 0px, transparent 50%),
                radial-gradient(at 100% 100%, rgba(5, 150, 105, 0.2) 0px, transparent 50%),
                radial-gradient(at 0% 100%, rgba(110, 231, 183, 0.1) 0px, transparent 50%);
            z-index: 1;
        }

        .text-gradient-emerald {
            background: linear-gradient(90deg, #6ee7b7, #34d399);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .text-emerald-light { color: #6ee7b7 !important; }
        .text-emerald { color: #059669 !important; }

        .badge-secure {
            display: inline-flex;
            align-items: center;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            color: white;
            padding: 10px 20px;
            border-radius: 50px;
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 1px;
            text-transform: uppercase;
        }

        .btn-ai-premium {
            background: white;
            color: #064e3b;
            padding: 15px 35px;
            border-radius: 16px;
            font-weight: 800;
            border: none;
            box-shadow: 0 10px 30px rgba(0,0,0,0.2);
            transition: all 0.4s ease;
        }
        .btn-ai-premium:hover {
            transform: scale(1.05);
            box-shadow: 0 15px 40px rgba(0,0,0,0.3);
            background: #f0fdf4;
        }

        .floating-card-emerald {
            position: absolute;
            top: 10%;
            right: 0;
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.2);
            padding: 15px 25px;
            border-radius: 20px;
            color: white;
            z-index: 10;
            animation: floating 5s infinite ease-in-out;
        }

        .glass-report-card {
            background: rgba(255, 255, 255, 0.03);
            backdrop-filter: blur(30px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 30px;
        }

        .card-glass-dark {
            background: rgba(0, 0, 0, 0.2);
            border: 1px solid rgba(255, 255, 255, 0.05);
            padding: 25px;
            border-radius: 20px;
        }

        .spinner-glow {
            width: 50px;
            height: 50px;
            border: 4px solid rgba(255,255,255,0.1);
            border-top: 4px solid #6ee7b7;
            border-radius: 50%;
            display: inline-block;
            animation: spin 1s linear infinite;
        }

        @keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }

        .msg-reveal {
            animation: fadeInUp 0.8s ease forwards;
        }

        .hero-img-management {
            filter: drop-shadow(0 30px 60px rgba(0,0,0,0.4));
        }

        /* Original styles preserved */
        .card {
            transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275), box-shadow 0.4s ease;
        }
        
        .animated-card {
            animation: fadeInUp 0.6s ease forwards;
            opacity: 0;
            transform: translateY(20px);
        }
        
        /* Apply delays to list elements */
        #management-list-container > * {
            animation: fadeInUp 0.5s ease forwards;
            opacity: 0;
            transform: translateY(20px);
        }
        
        #management-list-container > *:nth-child(1) { animation-delay: 0.1s; }
        #management-list-container > *:nth-child(2) { animation-delay: 0.2s; }
        #management-list-container > *:nth-child(3) { animation-delay: 0.3s; }
        #management-list-container > *:nth-child(4) { animation-delay: 0.4s; }
        
        .card:hover {
            box-shadow: 0 15px 35px rgba(124, 58, 237, 0.12) !important;
        }

        @keyframes fadeInUp {
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        
        .btn-outline-primary {
            color: var(--finora-purple);
            border-color: var(--finora-purple);
        }
        
        .btn-outline-primary:hover {
            background-color: var(--finora-purple);
            color: white;
            box-shadow: 0 5px 15px rgba(124, 58, 237, 0.4);
            transform: translateY(-2px);
        }
        
        .form-control:focus, .form-select:focus {
            border-color: var(--finora-purple) !important;
            box-shadow: 0 0 0 0.25rem rgba(124, 58, 237, 0.25) !important;
        }

        @keyframes pulse {
            0%, 100% { transform: scale(1); opacity: 0.2; }
            50% { transform: scale(1.1); opacity: 0.3; }
        }

        .floating-anim {
            animation: floating 4s ease-in-out infinite;
        }

        @keyframes floating {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-15px); }
        }
    </style>
{% endblock %}
{% block body %}
    <!-- 📂 Professional Portfolio Cockpit -->
    <section class="py-4 mb-5 position-relative overflow-hidden" style="background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 100%); border-radius: 0 0 40px 40px; margin-top: -24px; margin-left: -12px; margin-right: -12px;">
        <div class="container position-relative z-1">
            <div class="row align-items-center">
                <div class="col-lg-8 text-white">
                    <div class="d-flex align-items-center mb-3">
                        <div class="p-2 bg-white bg-opacity-10 rounded-circle me-3 border border-white border-opacity-10">
                            <i class="bi bi-shield-shaded text-white fs-5"></i>
                        </div>
                        <span class="text-uppercase fw-bold text-white-50 small" style="letter-spacing: 2px; font-size: 0.7rem;">Gestionnaire de Portefeuille</span>
                    </div>
                    <h1 class="display-5 fw-black text-white mb-2" style="letter-spacing: -2px;">
                        Analyse & <span class="text-primary-light" style="color: #a78bfa !important;">Performance</span>
                    </h1>
                    <p class="text-white-50 mb-4 fw-normal opacity-75">
                        Pilotage institutionnel de vos actifs et audits IA en temps réel.
                    </p>
                    
                    <div class="d-flex gap-4 align-items-center flex-wrap">
                        <div class="d-flex flex-column">
                            <span class="h3 fw-black text-white mb-0">{{ managements.getTotalItemCount }}</span>
                            <span class="small text-white-50 text-uppercase fw-bold ls-1" style="font-size: 0.6rem;">Actifs</span>
                        </div>
                        <div class="vr bg-white opacity-10" style="height: 40px;"></div>
                        <div class="d-flex flex-column">
                            <span class="h3 fw-black text-primary-light mb-0" style="color: #a78bfa !important;">OPTIMISÉ</span>
                            <span class="small text-white-50 text-uppercase fw-bold ls-1" style="font-size: 0.6rem;">Status</span>
                        </div>
                        <div class="ms-lg-3">
                            <button id="btnAiAnalyze" class="btn btn-primary px-4 py-2 rounded-pill fw-bold shadow-lg small" style="background: #7c3aed; border: none; font-size: 0.85rem;">
                                <i class="bi bi-magic me-2"></i>Diagnostic IA
                            </button>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4 d-none d-lg-block text-end">
                    <i class="bi bi-cpu text-white opacity-10" style="font-size: 120px;"></i>
                </div>
            </div>
        </div>
    </section>

    <div class="row g-4">
        <!-- ======================= SIDEBAR START (Left) ======================= -->
        <div class="col-xl-3">
            <div class="sticky-top" style="top: 2rem;">
                <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white">
                    <h5 class="fw-bold mb-4 border-bottom pb-3"><i class="bi bi-funnel me-2 text-primary"></i>Filtres</h5>
                    <form id="portfolio-filter-form" method="get" action="{{ path('app_management_index') }}">
                        <div class="mb-4">
                            <label class="form-label small text-uppercase fw-bold text-muted" style="letter-spacing: 1px;">Recherche</label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-light border-0"><i class="bi bi-search"></i></span>
                                <input type="text" name="search" class="form-control bg-light border-0" placeholder="Projet..." value="{{ search }}">
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label small text-uppercase fw-bold text-muted" style="letter-spacing: 1px;">Status Actif</label>
                            <select name="status" class="form-select bg-light border-0">
                                <option value="">Tous les status</option>
                                <option value="ACTIVE" {{ status == 'ACTIVE' ? 'selected' : '' }}>Actif</option>
                                <option value="CRITICAL" {{ status == 'CRITICAL' ? 'selected' : '' }}>Critique</option>
                                <option value="CLOSED" {{ status == 'CLOSED' ? 'selected' : '' }}>Clôturé</option>
                            </select>
                        </div>

                        <div class="mb-4">
                            <label class="form-label small text-uppercase fw-bold text-muted" style="letter-spacing: 1px;">Type d'Actif</label>
                            <div class="d-flex flex-column gap-2">
                                {% for key, label in {
                                    'IMMOBILIER': 'Immobilier',
                                    'STARTUP': 'Startup',
                                    'AGRICULTURE': 'Agriculture',
                                    'ENERGIE': 'Énergie'
                                } %}
                                <div class="form-check small">
                                    <input class="form-check-input" type="checkbox" name="types[]" value="{{ key }}" id="type_{{ key }}" {{ key in types ? 'checked' : '' }}>
                                    <label class="form-check-label" for="type_{{ key }}">{{ label }}</label>
                                </div>
                                {% endfor %}
                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 rounded-pill shadow-sm py-2 fw-bold">
                            Appliquer les filtres
                        </button>
                        <a href="{{ path('app_management_index') }}" class="btn btn-link w-100 text-muted small mt-2">Réinitialiser</a>
                    </form>
                </div>

                <!-- Portfolio Stats Badge -->
                <div class="card border-0 shadow-sm rounded-4 p-4 text-center bg-white">
                    <img src="{{ asset('assets/images/element/04.svg') }}" class="mb-3 mx-auto" style="width: 50px;" alt="">
                    <h6 class="fw-bold mb-2">Portfolio Sécurisé</h6>
                    <p class="small text-muted mb-0">Vos actifs sont audités par Finora IA pour maximiser vos rendements.</p>
                </div>
            </div>
        </div>

        <!-- ======================= MAIN CONTENT START (Right) ======================= -->
        <div class="col-xl-9">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h4 class="fw-bold mb-0 text-dark">{{ managements.getTotalItemCount }} investissement(s)</h4>
                    <p class="text-muted small mb-0">Vue détaillée de votre portefeuille stratégique</p>
                </div>
                <div class="d-flex gap-2">
                    <a href="{{ path('app_management_export_portfolio') }}" class="btn btn-outline-primary rounded-pill px-4 shadow-sm border-2">
                        <i class="bi bi-file-earmark-bar-graph me-1"></i>Rapport PDF
                    </a>
                    <a href="{{ path('app_investment_index') }}" class="btn btn-dark rounded-pill px-4 shadow-sm">
                        <i class="bi bi-plus-lg me-1"></i>Nouvel Investissement
                    </a>
                </div>
            </div>

            <!-- AI Diagnostic (Dynamic) -->
            <div id="aiReportContainer" class="mb-5 p-4 rounded-4" style="display: none; background: #f8fafc; border: 1px solid #e2e8f0;">
                <div id="aiLoader" class="text-center py-5">
                    <div class="spinner-border text-primary" role="status"></div>
                    <p class="mt-3 fw-bold text-dark">Génération du rapport stratégique...</p>
                </div>
                <div id="aiReportContent" class="fade-in">
                    <div class="row g-4 mb-4">
                        <div class="col-md-6">
                            <div class="card border-0 shadow-sm p-4 h-100" style="background: white;">
                                <h6 class="fw-bold mb-4 text-uppercase small" style="letter-spacing: 1px;"><i class="bi bi-shield-check me-2 text-primary"></i>Profil de Risque</h6>
                                <div style="height: 250px;"><canvas id="chartRisk"></canvas></div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="card border-0 shadow-sm p-4 h-100" style="background: white;">
                                <h6 class="fw-bold mb-4 text-uppercase small" style="letter-spacing: 1px;"><i class="bi bi-pie-chart-fill me-2 text-success"></i>Diversification</h6>
                                <div style="height: 250px;"><canvas id="chartCategory"></canvas></div>
                            </div>
                        </div>
                    </div>
                    <div class="card border-0 shadow-sm p-4" style="background: white;">
                        <h6 class="fw-bold mb-3 text-muted text-uppercase small" style="letter-spacing: 1px;">Analyse Visionnaire</h6>
                        <div id="aiTextBody" class="lh-lg text-dark" style="font-size: 0.95rem;"></div>
                    </div>
                </div>
            </div>

            <div id="management-list-container">
                {% include 'investment_management/_management_list.html.twig' %}
            </div>
            
            <div class="mt-5 d-flex justify-content-center">
                {{ knp_pagination_render(managements) }}
            </div>
        </div>
    </div>

    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
    document.addEventListener('DOMContentLoaded', function() {
        let riskChart = null;
        let categoryChart = null;

        // AI Analyze logic
        const btnAnalyze = document.getElementById('btnAiAnalyze');
        const reportContainer = document.getElementById('aiReportContainer');
        const loader = document.getElementById('aiLoader');
        const reportBody = document.getElementById('aiReportContent');
        const aiTextBody = document.getElementById('aiTextBody');
 
        if(btnAnalyze) {
            btnAnalyze.addEventListener('click', function() {
                btnAnalyze.style.display = 'none';
                reportContainer.style.display = 'block';
                loader.style.display = 'block';
                reportBody.style.display = 'none';

                fetch('{{ path('app_management_ai_report') }}', {
                    method: 'POST',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                })
                .then(res => res.json())
                .then(data => {
                    loader.style.display = 'none';
                    reportBody.style.display = 'block';
                    
                    if(data.html) {
                        aiTextBody.innerHTML = data.html;
                        if(data.stats) {
                            renderAiCharts(data.stats);
                        }
                    } else if(data.error) {
                        aiTextBody.innerHTML = '<div class="alert alert-danger">' + data.error + '</div>';
                        btnAnalyze.style.display = 'inline-block';
                    }
                })
                .catch(err => {
                    loader.style.display = 'none';
                    btnAnalyze.style.display = 'inline-block';
                    reportContainer.style.display = 'none';
                    alert('Erreur lors du diagnostic IA.');
                });
            });
        }

        function renderAiCharts(stats) {
            // 1. RISK CHART
            const ctxRisk = document.getElementById('chartRisk').getContext('2d');
            if (riskChart) riskChart.destroy();
            riskChart = new Chart(ctxRisk, {
                type: 'doughnut',
                data: {
                    labels: ['FAIBLE', 'MOYEN', 'ÉLEVÉ'],
                    datasets: [{
                        data: stats.riskDistribution,
                        backgroundColor: ['#10b981', '#f59e0b', '#ef4444'],
                        borderWidth: 0,
                        hoverOffset: 15
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'bottom', labels: { usePointStyle: true, padding: 20, font: { weight: '600' } } }
                    },
                    cutout: '70%'
                }
            });

            // 2. CATEGORY CHART
            const ctxCat = document.getElementById('chartCategory').getContext('2d');
            if (categoryChart) categoryChart.destroy();
            categoryChart = new Chart(ctxCat, {
                type: 'pie',
                data: {
                    labels: stats.categoryDistribution.labels,
                    datasets: [{
                        data: stats.categoryDistribution.data,
                        backgroundColor: ['#6366f1', '#8b5cf6', '#ec4899', '#f43f5e', '#3b82f6', '#14b8a6'],
                        borderWidth: 2,
                        borderColor: '#fff'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'bottom', labels: { usePointStyle: true, padding: 20, font: { weight: '600' } } }
                    }
                }
            });
        }

        // AJAX Filtering logic
        const filterForm = document.getElementById('portfolio-filter-form');
        const container = document.getElementById('management-list-container');

        if (filterForm) {
            filterForm.querySelectorAll('input, select').forEach(el => {
                el.addEventListener('change', () => updateResults());
            });

            filterForm.addEventListener('submit', (e) => {
                e.preventDefault();
                updateResults();
            });
        }

        function updateResults() {
            container.style.opacity = '0.5';
            const formData = new FormData(filterForm);
            const params = new URLSearchParams(formData);
            const url = `{{ path('app_management_index') }}?${params.toString()}`;

            fetch(url, {
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            })
            .then(res => res.text())
            .then(html => {
                container.innerHTML = html;
                container.style.opacity = '1';
                window.history.pushState({}, '', url);
            })
            .catch(err => {
                console.error(err);
                container.style.opacity = '1';
            });
        }

        // AJAX Pagination
        container.addEventListener('click', (e) => {
            const link = e.target.closest('.pagination a');
            if (link) {
                e.preventDefault();
                container.style.opacity = '0.5';
                fetch(link.href, {
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                })
                .then(res => res.text())
                .then(html => {
                    container.innerHTML = html;
                    container.style.opacity = '1';
                    window.history.pushState({}, '', link.href);
                    window.scrollTo({ top: 0, behavior: 'smooth' });
                });
            }
        });
    });
    </script>
    {% include 'investment/_robo_advisor_modal.html.twig' %}
{% endblock %}
