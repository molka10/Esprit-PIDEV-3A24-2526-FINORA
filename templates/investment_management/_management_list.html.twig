<div class="row g-4" id="management-list-container">
    {% for item in managements %}
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden transition-all hover-shadow-lg bg-white" style="animation-delay: {{ loop.index0 * 100 }}ms;">
                <!-- Image Section -->
                <div class="position-relative">
                    <img src="{{ investment_image_src(item.investment) ?: asset('assets/images/courses/4by3/06.jpg') }}" 
                         alt="{{ item.investment.name|default('Inconnu') }}"
                         class="card-img-top" style="height: 160px; object-fit: cover;">
                    
                    <div class="position-absolute top-0 end-0 p-2">
                        {% if item.status == 'ACTIVE' %}
                            <span class="badge rounded-pill px-2 py-1 bg-success shadow-sm small" style="font-size: 0.6rem;">ACTIF</span>
                        {% elseif item.status == 'CRITICAL' %}
                            <span class="badge rounded-pill px-2 py-1 bg-warning text-dark shadow-sm small" style="font-size: 0.6rem;">CRITIQUE</span>
                        {% else %}
                            <span class="badge rounded-pill px-2 py-1 bg-secondary shadow-sm small" style="font-size: 0.6rem;">CLÔTURÉ</span>
                        {% endif %}
                    </div>
                </div>

                <div class="card-body p-4 d-flex flex-column">
                    <small class="text-primary fw-bold text-uppercase mb-1 d-block" style="font-size: 0.6rem; color: #7c3aed !important;">
                        {{ investment_category_label(item.investmentType) }}
                    </small>
                    <h6 class="fw-bold text-dark mb-3 text-truncate">
                        <a href="{{ path('app_management_show', {'id': item.id}) }}" class="text-dark text-decoration-none">
                            {{ item.investment.name|default('Sans nom') }}
                        </a>
                    </h6>
                    
                    <div class="bg-light p-3 rounded-3 mb-3 border border-white">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted small">Investi</span>
                            <span class="fw-bold small">{{ (item.amountInvested ?? 0)|format_currency }}</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span class="text-muted small">Part</span>
                            <span class="fw-bold text-primary small">{{ item.ownershipPercentage ?? 0 }}%</span>
                        </div>
                    </div>
                    
                    <!-- Progress Section -->
                    <div class="mb-4">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="small text-muted fw-bold" style="font-size: 0.6rem;">CYCLE</span>
                            <span class="small fw-bold text-primary" style="font-size: 0.6rem;">{{ item.getProgressPercentage() }}%</span>
                        </div>
                        <div class="progress" style="height: 4px; border-radius: 10px;">
                            <div class="progress-bar" role="progressbar" style="width: {{ item.getProgressPercentage() }}%; background: #7c3aed;"></div>
                        </div>
                    </div>
                    
                    <div class="mt-auto d-flex justify-content-between align-items-center">
                        <a href="{{ path('app_management_show', {'id': item.id}) }}" class="btn btn-outline-primary btn-sm rounded-pill px-3" style="font-size: 0.75rem;">
                            Détails <i class="bi bi-arrow-right ms-1"></i>
                        </a>
                        <div class="btn-group">
                            <a href="{{ path('app_management_edit', {'id': item.id}) }}" class="btn btn-light btn-sm text-warning p-1" title="Modifier">
                                <i class="bi bi-pencil-square"></i>
                            </a>
                            <form method="post" action="{{ path('app_management_delete', {'id': item.id}) }}" onsubmit="return confirm('Supprimer ?');" style="display:inline;">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ item.id) }}">
                                <button class="btn btn-light btn-sm text-danger p-1"><i class="bi bi-trash"></i></button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    {% else %}
        <div class="col-12 text-center py-5 bg-light rounded-4">
            <i class="bi bi-inbox fs-1 text-muted mb-3 d-block"></i>
            <h5 class="text-muted">Aucun investissement trouvé</h5>
            <a href="{{ path('app_investment_index') }}" class="btn btn-primary btn-sm mt-3 px-4 rounded-pill">Explorer</a>
        </div>
    {% endfor %}

    <div class="col-12 d-flex justify-content-center mt-4">
        {{ knp_pagination_render(managements) }}
    </div>
</div>
