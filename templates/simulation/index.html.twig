{% extends 'base.html.twig' %}
{% block title %}Simulation - FINORA{% endblock %}
{% block breadcrumb %}Simulation{% endblock %}

{% block stylesheets %}{{ parent() }}
<style>
:root { --sim-green: #10b981; --sim-red: #ef4444; --sim-purple: #7c3aed; }
.sim-hero { background: linear-gradient(135deg, #1e0a3c 0%, #3b1278 50%, #4338ca 100%); border-radius: 24px; padding: 40px; color: white; position: relative; overflow: hidden; margin-bottom: 24px; }
.sim-hero::before { content:''; position:absolute; top:-60px; right:-60px; width:200px; height:200px; background:rgba(255,255,255,0.05); border-radius:50%; }
.sim-hero::after { content:''; position:absolute; bottom:-40px; left:30%; width:120px; height:120px; background:rgba(124,58,237,0.3); border-radius:50%; }
.balance-card { background: white; border-radius: 20px; padding: 24px; box-shadow: 0 8px 30px rgba(124,58,237,0.1); border: 1px solid rgba(124,58,237,0.1); }
.asset-row { display:flex; align-items:center; justify-content:space-between; padding:12px 16px; border-radius:12px; border:1px solid #f1f5f9; margin-bottom:8px; transition:all 0.2s; cursor:pointer; background:white; }
.asset-row:hover { border-color: rgba(124,58,237,0.3); background: rgba(124,58,237,0.02); transform:translateX(4px); }
.price-up { color: var(--sim-green); }
.price-down { color: var(--sim-red); }
.scenario-card { border-radius: 20px; border: 2px solid #f1f5f9; padding: 20px; cursor: pointer; transition: all 0.3s; background: white; height: 100%; }
.scenario-card:hover { border-color: #7c3aed; transform: translateY(-4px); box-shadow: 0 12px 30px rgba(124,58,237,0.15); }
.qty-input { width: 80px; border: 2px solid #e2e8f0; border-radius: 10px; padding: 6px 10px; text-align:center; font-weight:700; }
.qty-input:focus { outline:none; border-color:#7c3aed; }
.portfolio-item { display:flex; align-items:center; justify-content:space-between; padding:10px 14px; border-radius:12px; background:#f8fafc; margin-bottom:6px; }
.btn-buy { background:linear-gradient(135deg,#10b981,#059669); color:white; border:none; border-radius:10px; padding:8px 18px; font-weight:700; font-size:13px; transition:all 0.2s; }
.btn-sell { background:linear-gradient(135deg,#ef4444,#dc2626); color:white; border:none; border-radius:10px; padding:8px 18px; font-weight:700; font-size:13px; transition:all 0.2s; }
.pnl-positive { color: var(--sim-green); font-weight:800; }
.pnl-negative { color: var(--sim-red); font-weight:800; }
.toast-sim { position:fixed; bottom:90px; right:24px; z-index:9999; border-radius:14px; padding:14px 20px; font-weight:600; color:white; font-size:14px; box-shadow:0 8px 25px rgba(0,0,0,0.2); transition:all 0.4s; }
.section-title { font-weight:800; font-size:1.1rem; color:#1e0a3c; margin-bottom:16px; display:flex; align-items:center; gap:8px; }

/* Custom Tabs */
.sim-tabs { display:flex; gap:10px; margin-bottom:20px; border-bottom: 2px solid #f1f5f9; padding-bottom: 10px; flex-wrap: wrap;}
.sim-tab { background: transparent; border: none; padding: 10px 20px; font-weight: 700; color: #64748b; border-radius: 12px; transition: all 0.2s; }
.sim-tab:hover { background: rgba(124,58,237,0.05); color: #7c3aed; }
.sim-tab.active { background: #7c3aed; color: white; box-shadow: 0 4px 15px rgba(124,58,237,0.3); }

/* Skills Badges */
.skill-badge { font-size: 0.75rem; background: rgba(124,58,237,0.1); color: #7c3aed; padding: 4px 8px; border-radius: 6px; font-weight: 600; }
</style>
{% endblock %}

{% block body %}
<!-- Hero -->
<div class="sim-hero">
    <div style="position:relative;z-index:2;">
        <div class="d-flex align-items-center gap-3 mb-3">
            <div style="background:rgba(255,255,255,0.15);padding:12px;border-radius:16px;font-size:28px;">⚡</div>
            <div>
                <h1 class="mb-0 fw-800" style="font-size:1.8rem;">Ecosystème de Simulation</h1>
                <p class="mb-0 opacity-75">Pratiquez sans risque dans tous les domaines : Bourse, Investissement et Appels d'Offres</p>
            </div>
        </div>
        <div class="d-flex gap-3 flex-wrap">
            <span class="badge" style="background:rgba(16,185,129,0.2);color:#6ee7b7;padding:8px 14px;border-radius:20px;font-size:12px;">✅ Zéro risque financier</span>
            <span class="badge" style="background:rgba(245,158,11,0.2);color:#fcd34d;padding:8px 14px;border-radius:20px;font-size:12px;">📊 Expérience réaliste</span>
            <span class="badge" style="background:rgba(124,58,237,0.3);color:#c4b5fd;padding:8px 14px;border-radius:20px;font-size:12px;">🎯 Apprentissage actif</span>
        </div>
    </div>
</div>

<!-- Virtual Balance Global -->
<div class="balance-card mb-4">
    <div class="row align-items-center g-3">
        <div class="col-md-3 text-center">
            <div class="text-muted small fw-bold text-uppercase mb-1" style="font-size:10px;letter-spacing:1px;">Solde Virtuel (Liquide)</div>
            <div id="balanceDisplay" class="fw-800" style="font-size:1.8rem;color:#7c3aed;">$10,000.00</div>
        </div>
        <div class="col-md-3 text-center border-start">
            <div class="text-muted small fw-bold text-uppercase mb-1" style="font-size:10px;letter-spacing:1px;">Valeur Actifs (Bourse & Inv)</div>
            <div id="portfolioValue" class="fw-800" style="font-size:1.8rem;color:#1e0a3c;">$0.00</div>
        </div>
        <div class="col-md-3 text-center border-start">
            <div class="text-muted small fw-bold text-uppercase mb-1" style="font-size:10px;letter-spacing:1px;">Réputation / Score</div>
            <div id="scoreDisplay" class="fw-800" style="font-size:1.8rem;color:#f59e0b;"><i class="bi bi-star-fill me-1"></i>0</div>
        </div>
        <div class="col-md-3 text-center border-start">
            <button onclick="resetSimulation()" class="btn btn-outline-danger btn-sm rounded-pill px-3">
                <i class="bi bi-arrow-counterclockwise me-1"></i>Reset Global
            </button>
        </div>
    </div>
</div>

<!-- Tabs Navigation -->
<div class="sim-tabs">
    <button class="sim-tab active" onclick="switchTab('trading')"><i class="bi bi-graph-up me-2"></i>Bourse & Trading</button>
    <button class="sim-tab" onclick="switchTab('invest')"><i class="bi bi-building me-2"></i>Investissement</button>
    <button class="sim-tab" onclick="switchTab('appel')"><i class="bi bi-briefcase me-2"></i>Appels d'Offres</button>
</div>

<div class="row g-4">
    <!-- LEFT: Content Area -->
    <div class="col-lg-8">
        
        <!-- ================= TAB: TRADING ================= -->
        <div id="tab-trading" class="sim-tab-content">
            <!-- Market Assets -->
            <div class="balance-card mb-4">
                <div class="section-title"><i class="bi bi-graph-up" style="color:#7c3aed;"></i>Marché en Direct</div>
                <div id="assetList">
                    {% for asset in assets %}
                    <div class="asset-row" id="asset-{{ asset.symbol }}">
                        <div class="d-flex align-items-center gap-3">
                            <div style="width:40px;height:40px;border-radius:12px;background:rgba(124,58,237,0.1);display:flex;align-items:center;justify-content:center;font-size:18px;">
                                <i class="bi {{ asset.icon }}" style="color:#7c3aed;"></i>
                            </div>
                            <div>
                                <div class="fw-700" style="font-size:0.9rem;">{{ asset.symbol }}</div>
                                <div class="text-muted" style="font-size:11px;">{{ asset.name }}</div>
                            </div>
                        </div>
                        <div class="text-end d-none d-sm-block">
                            <div class="fw-700">${{ asset.price|number_format(2) }}</div>
                            <div class="small fw-600 {{ asset.change >= 0 ? 'price-up' : 'price-down' }}">
                                {{ asset.change >= 0 ? '+' : '' }}{{ asset.change }}%
                            </div>
                        </div>
                        <div class="d-flex align-items-center gap-2 ms-3">
                            <input type="number" class="qty-input" id="qty-{{ asset.symbol }}" value="1" min="1" onclick="event.stopPropagation()">
                            <button class="btn-buy" onclick="event.stopPropagation(); tradeAsset('{{ asset.symbol }}', {{ asset.price }}, '{{ asset.name }}', 'buy')">
                                Acheter
                            </button>
                            <button class="btn-sell" onclick="event.stopPropagation(); tradeAsset('{{ asset.symbol }}', {{ asset.price }}, '{{ asset.name }}', 'sell')">
                                Vendre
                            </button>
                        </div>
                    </div>
                    {% endfor %}
                </div>
            </div>

            <!-- Scenarios -->
            <div class="balance-card">
                <div class="section-title"><i class="bi bi-lightning-charge-fill" style="color:#f59e0b;"></i>Scénarios de Marché</div>
                <div class="row g-3">
                    {% for scenario in scenarios %}
                    <div class="col-md-6">
                        <div class="scenario-card" onclick="runScenario('{{ scenario.id }}', {{ scenario.impact }}, '{{ scenario.title }}')">
                            <div class="d-flex align-items-start gap-3 mb-2">
                                <span style="font-size:2rem;">{{ scenario.emoji }}</span>
                                <div>
                                    <div class="fw-700" style="font-size:0.95rem;">{{ scenario.title }}</div>
                                    <span class="badge {{ scenario.badge_class }} bg-opacity-10 text-{{ scenario.badge_class|replace({'bg-':'','text-':''}) }} rounded-pill" style="font-size:10px;">{{ scenario.difficulty }}</span>
                                </div>
                            </div>
                            <p class="text-muted small mb-2">{{ scenario.description }}</p>
                            <div class="d-flex align-items-center justify-content-between mt-auto">
                                <span class="small fw-600 {{ scenario.impact >= 0 ? 'text-success' : 'text-danger' }}">
                                    Impact : {{ scenario.impact >= 0 ? '+' : '' }}{{ scenario.impact }}%
                                </span>
                                <span class="badge" style="background:rgba(124,58,237,0.1);color:#7c3aed;font-size:10px;">Simuler →</span>
                            </div>
                        </div>
                    </div>
                    {% endfor %}
                </div>
            </div>
        </div>

        <!-- ================= TAB: INVESTISSEMENT ================= -->
        <div id="tab-invest" class="sim-tab-content" style="display:none;">
            <div class="balance-card">
                <div class="section-title"><i class="bi bi-building" style="color:#7c3aed;"></i>Opportunités d'Investissement</div>
                <p class="text-muted small mb-4">Investissez dans des projets à moyen/long terme pour générer des revenus passifs.</p>
                
                <div class="row g-3">
                    {% for inv in investments %}
                    <div class="col-12">
                        <div class="asset-row p-3 flex-wrap">
                            <div class="d-flex align-items-center gap-3">
                                <div style="width:48px;height:48px;border-radius:12px;background:rgba(124,58,237,0.1);display:flex;align-items:center;justify-content:center;font-size:20px;">
                                    <i class="bi {{ inv.icon }}" style="color:#7c3aed;"></i>
                                </div>
                                <div>
                                    <div class="fw-700" style="font-size:1rem;">{{ inv.name }}</div>
                                    <div class="d-flex gap-2 align-items-center">
                                        <span class="badge bg-light text-dark">{{ inv.category }}</span>
                                        <span class="text-muted" style="font-size:11px;"><i class="bi bi-clock me-1"></i>{{ inv.duration }}</span>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="text-center px-4 border-start border-end d-none d-sm-block">
                                <div class="text-muted" style="font-size:11px;">Rendement</div>
                                <div class="fw-800 text-success" style="font-size:1.1rem;">+{{ inv.yield }}%</div>
                                <div class="small fw-600 {{ inv.risk == 'HIGH' ? 'text-danger' : (inv.risk == 'MEDIUM' ? 'text-warning' : 'text-success') }}" style="font-size:10px;">
                                    Risque: {{ inv.risk }}
                                </div>
                            </div>

                            <div class="text-end d-flex align-items-center gap-3 mt-3 mt-md-0">
                                <div>
                                    <div class="text-muted" style="font-size:11px;">Ticket</div>
                                    <div class="fw-700">${{ inv.amount|number_format(0) }}</div>
                                </div>
                                <button class="btn-buy" onclick="investProject('{{ inv.id }}', '{{ inv.name }}', {{ inv.amount }}, {{ inv.yield }})">
                                    Investir
                                </button>
                            </div>
                        </div>
                    </div>
                    {% endfor %}
                </div>
            </div>
        </div>

        <!-- ================= TAB: APPEL D'OFFRE ================= -->
        <div id="tab-appel" class="sim-tab-content" style="display:none;">
             <div class="balance-card">
                <div class="section-title"><i class="bi bi-briefcase" style="color:#7c3aed;"></i>Appels d'Offres Freelance</div>
                <p class="text-muted small mb-4">Postulez à des projets virtuels. Si votre candidature est retenue (simulation aléatoire), vous gagnez le budget et augmentez votre réputation !</p>

                <div class="row g-3">
                    {% for appel in appels %}
                    <div class="col-md-6">
                        <div class="scenario-card d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <span class="badge bg-primary bg-opacity-10 text-primary">{{ appel.category }}</span>
                                <span class="fw-800 text-success">{{ appel.budget }}</span>
                            </div>
                            <h5 class="fw-700" style="font-size:1rem;">{{ appel.title }}</h5>
                            <div class="mb-3 d-flex flex-wrap gap-1 mt-2">
                                {% for skill in appel.skills %}
                                    <span class="skill-badge">{{ skill }}</span>
                                {% endfor %}
                            </div>
                            <div class="d-flex justify-content-between align-items-center mt-auto pt-3 border-top">
                                <span class="text-muted small"><i class="bi bi-clock me-1"></i>{{ appel.deadline }}</span>
                                <button class="btn btn-sm btn-outline-primary fw-bold" onclick="applyForJob('{{ appel.id }}', '{{ appel.title }}', '{{ appel.budget }}', '{{ appel.difficulty }}')">
                                    Postuler
                                </button>
                            </div>
                        </div>
                    </div>
                    {% endfor %}
                </div>
            </div>
        </div>

    </div>

    <!-- RIGHT: Portfolio / Dashboard Global -->
    <div class="col-lg-4">
        <div class="balance-card" style="position:sticky;top:100px;">
            <div class="section-title"><i class="bi bi-pie-chart-fill" style="color:#7c3aed;"></i>Mes Actifs</div>
            
            <ul class="nav nav-pills mb-3 mt-3 nav-justified" id="pills-tab" role="tablist">
              <li class="nav-item" role="presentation">
                <button class="nav-link active py-1 px-2 small" id="pills-bourse-tab" data-bs-toggle="pill" data-bs-target="#pills-bourse" type="button" role="tab" style="font-size:12px;font-weight:600;">Bourse</button>
              </li>
              <li class="nav-item" role="presentation">
                <button class="nav-link py-1 px-2 small" id="pills-invest-tab" data-bs-toggle="pill" data-bs-target="#pills-invest" type="button" role="tab" style="font-size:12px;font-weight:600;">Invest.</button>
              </li>
              <li class="nav-item" role="presentation">
                <button class="nav-link py-1 px-2 small" id="pills-jobs-tab" data-bs-toggle="pill" data-bs-target="#pills-jobs" type="button" role="tab" style="font-size:12px;font-weight:600;">Projets</button>
              </li>
            </ul>

            <div class="tab-content" id="pills-tabContent">
                <!-- Bourse content -->
                <div class="tab-pane fade show active" id="pills-bourse" role="tabpanel">
                    <div id="portfolioContainer">
                        <div class="text-center py-4 text-muted" id="emptyPortfolio">
                            <i class="bi bi-graph-down" style="font-size:2rem;opacity:0.3;"></i>
                            <p class="mt-2 small">Aucune action achetée.</p>
                        </div>
                    </div>
                </div>
                
                <!-- Invest content -->
                <div class="tab-pane fade" id="pills-invest" role="tabpanel">
                    <div id="investContainer">
                        <div class="text-center py-4 text-muted">
                            <i class="bi bi-building" style="font-size:2rem;opacity:0.3;"></i>
                            <p class="mt-2 small">Aucun investissement en cours.</p>
                        </div>
                    </div>
                </div>

                <!-- Jobs content -->
                <div class="tab-pane fade" id="pills-jobs" role="tabpanel">
                    <div id="jobsContainer">
                        <div class="text-center py-4 text-muted">
                            <i class="bi bi-briefcase" style="font-size:2rem;opacity:0.3;"></i>
                            <p class="mt-2 small">Aucun projet remporté.</p>
                        </div>
                    </div>
                </div>
            </div>

            <hr>
            <div class="section-title mt-3"><i class="bi bi-clock-history" style="color:#64748b;"></i>Historique Global</div>
            <div id="tradeHistory" style="max-height:250px;overflow-y:auto;">
                <p class="text-muted small text-center py-2">Aucune activité.</p>
            </div>
        </div>
    </div>
</div>

<!-- Scenario Result Modal -->
<div class="modal fade" id="scenarioModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0" style="border-radius:24px;overflow:hidden;">
            <div class="modal-header border-0" id="scenarioHeader" style="padding:24px;">
                <h5 class="modal-title fw-800" id="scenarioTitle"></h5>
            </div>
            <div class="modal-body" style="padding:24px;">
                <div id="scenarioResult" class="text-center py-3"></div>
            </div>
            <div class="modal-footer border-0">
                <button class="btn btn-primary rounded-pill px-4" data-bs-dismiss="modal">Compris !</button>
            </div>
        </div>
    </div>
</div>

<!-- Job Result Modal -->
<div class="modal fade" id="jobModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0" style="border-radius:24px;overflow:hidden;">
            <div class="modal-body text-center py-5 px-4" id="jobModalBody">
                <!-- Content injected via JS -->
            </div>
            <div class="modal-footer border-0 justify-content-center">
                <button class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Fermer</button>
            </div>
        </div>
    </div>
</div>

<div id="simToast" class="toast-sim" style="display:none;"></div>
{% endblock %}

{% block javascripts %}{{ parent() }}
<script>
let balance = 10000;
let portfolio = {}; // Stock portfolio
let investments = []; // active investments
let wonJobs = []; // won appel d'offres
let score = 0;
let tradeCount = 0;

function formatMoney(n) {
    return '$' + n.toLocaleString('en-US', {minimumFractionDigits:2, maximumFractionDigits:2});
}

function showToast(msg, color) {
    const t = document.getElementById('simToast');
    t.style.background = color;
    t.innerHTML = msg;
    t.style.display = 'block';
    clearTimeout(window.toastTimeout);
    window.toastTimeout = setTimeout(() => { t.style.display = 'none'; }, 3000);
}

function switchTab(tabId) {
    document.querySelectorAll('.sim-tab').forEach(t => t.classList.remove('active'));
    event.currentTarget.classList.add('active');
    
    document.querySelectorAll('.sim-tab-content').forEach(c => c.style.display = 'none');
    document.getElementById('tab-' + tabId).style.display = 'block';
}

function updateBalanceUI() {
    document.getElementById('balanceDisplay').textContent = formatMoney(balance);
    
    let portfolioVal = 0;
    for (const sym in portfolio) {
        portfolioVal += portfolio[sym].qty * portfolio[sym].price;
    }
    
    let investVal = 0;
    investments.forEach(inv => { investVal += inv.amount; });

    document.getElementById('portfolioValue').textContent = formatMoney(portfolioVal + investVal);
    document.getElementById('scoreDisplay').innerHTML = `<i class="bi bi-star-fill me-1"></i>${score}`;
    
    renderPortfolio();
    renderInvestments();
    renderJobs();
}

// ---------- TRADING LOGIC ----------
function tradeAsset(symbol, price, name, action) {
    const qtyInput = document.getElementById('qty-' + symbol);
    const qty = parseInt(qtyInput.value) || 1;
    const total = price * qty;

    if (action === 'buy') {
        if (total > balance) {
            showToast('❌ Solde insuffisant !', '#ef4444');
            return;
        }
        balance -= total;
        if (!portfolio[symbol]) portfolio[symbol] = {name, qty:0, price, cost:0};
        portfolio[symbol].qty += qty;
        portfolio[symbol].cost += total;
        showToast(`✅ Acheté ${qty}x ${symbol}`, '#10b981');
    } else {
        if (!portfolio[symbol] || portfolio[symbol].qty < qty) {
            showToast('❌ Positions insuffisantes !', '#ef4444');
            return;
        }
        balance += total;
        const avgCost = portfolio[symbol].cost / portfolio[symbol].qty;
        portfolio[symbol].cost -= avgCost * qty;
        portfolio[symbol].qty -= qty;
        if (portfolio[symbol].qty === 0) delete portfolio[symbol];
        showToast(`🔴 Vendu ${qty}x ${symbol}`, '#f59e0b');
    }

    addHistory(action === 'buy' ? 'Achat Bourse' : 'Vente Bourse', symbol, total, action === 'buy' ? 'out' : 'in');
    updateBalanceUI();
}

function renderPortfolio() {
    const container = document.getElementById('portfolioContainer');
    if (Object.keys(portfolio).length === 0) {
        container.innerHTML = `<div class="text-center py-4 text-muted"><i class="bi bi-graph-down" style="font-size:2rem;opacity:0.3;"></i><p class="mt-2 small">Aucune action achetée.</p></div>`;
        return;
    }
    let html = '';
    for (const sym in portfolio) {
        const p = portfolio[sym];
        const currentVal = p.qty * p.price;
        const pnl = currentVal - p.cost;
        const pnlClass = pnl >= 0 ? 'pnl-positive' : 'pnl-negative';
        html += `<div class="portfolio-item">
            <div><div style="font-size:13px;font-weight:700;">${sym}</div><div style="font-size:10px;color:#94a3b8;">${p.name}</div></div>
            <div class="text-center"><div style="font-size:12px;font-weight:600;">x${p.qty}</div></div>
            <div class="text-end"><div style="font-size:13px;font-weight:700;">${formatMoney(currentVal)}</div><div class="small ${pnlClass}">${pnl>=0?'+':''}${formatMoney(pnl)}</div></div>
        </div>`;
    }
    container.innerHTML = html;
}

// ---------- SCENARIO LOGIC ----------
function runScenario(id, impact, title) {
    const modal = new bootstrap.Modal(document.getElementById('scenarioModal'));
    const header = document.getElementById('scenarioHeader');
    const result = document.getElementById('scenarioResult');
    document.getElementById('scenarioTitle').textContent = '⚡ ' + title;

    let portfolioVal = 0;
    for (const sym in portfolio) portfolioVal += portfolio[sym].qty * portfolio[sym].price;

    const impactAmount = portfolioVal * (impact / 100);
    const isPositive = impact >= 0;
    
    // Apply impact to portfolio (simulate price changes)
    if(portfolioVal > 0) {
        for (const sym in portfolio) {
            portfolio[sym].price = portfolio[sym].price * (1 + (impact/100));
        }
        updateBalanceUI();
    }

    header.style.background = isPositive ? 'linear-gradient(135deg,#d1fae5,#a7f3d0)' : 'linear-gradient(135deg,#fee2e2,#fecaca)';
    result.innerHTML = `
        <div style="font-size:4rem;margin-bottom:16px;">${isPositive ? '🚀' : '📉'}</div>
        <h4 class="fw-800" style="color:${isPositive?'#10b981':'#ef4444'};">${isPositive?'+':''}${impact}% ${isPositive?'de gain':'de perte'} sur vos actions</h4>
        <p class="text-muted">Impact estimé sur votre portefeuille :</p>
        <div style="font-size:2rem;font-weight:800;color:${isPositive?'#10b981':'#ef4444'};">
            ${isPositive?'+':''}${formatMoney(impactAmount)}
        </div>
        ${portfolioVal === 0 ? '<p class="text-muted small mt-3">💡 Achetez des actions pour voir l\'impact de la bourse.</p>' : ''}
        `;
    modal.show();
}

// ---------- INVESTMENT LOGIC ----------
function investProject(id, name, amount, yieldPct) {
    if (amount > balance) {
        showToast('❌ Solde insuffisant pour ce projet !', '#ef4444');
        return;
    }
    balance -= amount;
    investments.push({id, name, amount, yieldPct});
    showToast(`✅ Investi dans ${name}`, '#10b981');
    addHistory('Investissement', name, amount, 'out');
    updateBalanceUI();
    
    // Switch to Invest tab on the right
    const triggerEl = document.querySelector('#pills-invest-tab');
    bootstrap.Tab.getInstance(triggerEl)?.show() || new bootstrap.Tab(triggerEl).show();
}

function renderInvestments() {
    const container = document.getElementById('investContainer');
    if (investments.length === 0) {
        container.innerHTML = `<div class="text-center py-4 text-muted"><i class="bi bi-building" style="font-size:2rem;opacity:0.3;"></i><p class="mt-2 small">Aucun investissement en cours.</p></div>`;
        return;
    }
    let html = '';
    investments.forEach(inv => {
        const expectedReturn = inv.amount * (inv.yieldPct / 100);
        html += `<div class="portfolio-item">
            <div><div style="font-size:12px;font-weight:700;">${inv.name}</div></div>
            <div class="text-end"><div style="font-size:12px;font-weight:700;">${formatMoney(inv.amount)}</div><div class="small text-success">+${formatMoney(expectedReturn)}/an</div></div>
        </div>`;
    });
    container.innerHTML = html;
}

// ---------- APPEL D'OFFRE LOGIC ----------
function applyForJob(id, title, budgetStr, difficulty) {
    const budgetNum = parseInt(budgetStr.replace(/[^0-9]/g, ''));
    
    let winChance = 0.5; // base 50%
    if(difficulty === 'Senior') winChance = 0.3;
    if(difficulty === 'Junior') winChance = 0.7;
    
    const btn = event.currentTarget;
    const oldText = btn.innerHTML;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span>';
    btn.disabled = true;

    setTimeout(() => {
        btn.innerHTML = oldText;
        btn.disabled = false;
        
        const won = Math.random() < winChance;
        const modal = new bootstrap.Modal(document.getElementById('jobModal'));
        const body = document.getElementById('jobModalBody');
        
        if(won) {
            balance += budgetNum;
            score += 10; // Gain reputation
            wonJobs.push({title, budget: budgetNum});
            
            body.innerHTML = `
                <div style="font-size:4rem;margin-bottom:16px;">🎉</div>
                <h3 class="fw-800 text-success">Candidature Retenue !</h3>
                <p class="text-muted mt-3">Félicitations, vous avez remporté l'appel d'offre : <strong>${title}</strong></p>
                <div class="d-flex justify-content-center gap-4 mt-4">
                    <div class="text-center"><div class="small text-muted">Gain</div><div class="fw-800 fs-4 text-success">+${formatMoney(budgetNum)}</div></div>
                    <div class="text-center"><div class="small text-muted">Réputation</div><div class="fw-800 fs-4 text-warning">+10 <i class="bi bi-star-fill"></i></div></div>
                </div>
            `;
            addHistory('Appel d\'Offre Gagné', title, budgetNum, 'in');
            updateBalanceUI();
            
            const triggerEl = document.querySelector('#pills-jobs-tab');
            bootstrap.Tab.getInstance(triggerEl)?.show() || new bootstrap.Tab(triggerEl).show();

        } else {
            body.innerHTML = `
                <div style="font-size:4rem;margin-bottom:16px;">📄</div>
                <h3 class="fw-800 text-secondary">Candidature Non Retenue</h3>
                <p class="text-muted mt-3">Malheureusement, un autre candidat a été choisi pour : <strong>${title}</strong></p>
                <p class="small text-muted mt-2">Continuez à développer vos compétences ou postulez à d'autres projets !</p>
            `;
        }
        modal.show();
    }, 800);
}

function renderJobs() {
    const container = document.getElementById('jobsContainer');
    if (wonJobs.length === 0) {
        container.innerHTML = `<div class="text-center py-4 text-muted"><i class="bi bi-briefcase" style="font-size:2rem;opacity:0.3;"></i><p class="mt-2 small">Aucun projet remporté.</p></div>`;
        return;
    }
    let html = '';
    wonJobs.forEach(job => {
        html += `<div class="portfolio-item border-start border-4 border-success">
            <div><div style="font-size:12px;font-weight:700;">${job.title}</div><div style="font-size:10px;color:#10b981;">Terminé</div></div>
            <div class="text-end"><div style="font-size:12px;font-weight:700;color:#10b981;">+${formatMoney(job.budget)}</div></div>
        </div>`;
    });
    container.innerHTML = html;
}

// ---------- HISTORY & UTILS ----------
function addHistory(type, desc, amount, direction) {
    tradeCount++;
    const hist = document.getElementById('tradeHistory');
    if (tradeCount === 1) hist.innerHTML = '';
    
    let color = direction === 'in' ? '#10b981' : '#ef4444';
    let sign = direction === 'in' ? '+' : '-';
    
    const time = new Date().toLocaleTimeString('fr-FR', {hour:'2-digit', minute:'2-digit'});
    hist.innerHTML = `<div style="display:flex;justify-content:space-between;align-items:center;padding:8px;border-radius:8px;background:#f8fafc;margin-bottom:4px;font-size:12px;">
        <div><span style="font-weight:700;color:#1e0a3c;">${type}</span><div class="text-muted" style="font-size:10px;">${desc}</div></div>
        <div class="text-end"><span style="font-weight:700;color:${color};">${sign}${formatMoney(amount)}</span><div class="text-muted" style="font-size:10px;">${time}</div></div>
    </div>` + hist.innerHTML;
}

function resetSimulation() {
    if (!confirm('Réinitialiser toute la simulation ? Votre solde, portefeuille, investissements et réputation seront remis à zéro.')) return;
    balance = 10000;
    portfolio = {};
    investments = [];
    wonJobs = [];
    score = 0;
    tradeCount = 0;
    document.getElementById('tradeHistory').innerHTML = '<p class="text-muted small text-center py-2">Aucune activité.</p>';
    updateBalanceUI();
    showToast('🔄 Écosystème réinitialisé ($10,000 virtuels)', '#7c3aed');
}

// Init
updateBalanceUI();
</script>
{% endblock %}
