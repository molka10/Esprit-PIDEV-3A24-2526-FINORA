{% extends app.request.query.get('role') == 'admin' ? 'admin_base.html.twig' : 'base.html.twig' %}

{% block title %}Profil de {{ user.username }}{% endblock %}

{% block body %}
<div class="container-fluid p-0">
    <!-- Header Section -->
    <div class="position-relative mb-5">
        <div style="height: 180px; background: var(--finora-gradient-soft); border-radius: 0 0 40px 40px;" class="shadow-sm"></div>
        <div class="container position-relative" style="margin-top: -80px;">
            <div class="card border-0 shadow-lg" style="border-radius: 25px;">
                <div class="card-body p-4">
                    <div class="d-flex flex-column flex-md-row align-items-center text-center text-md-start">
                        <!-- Avatar -->
                        <div class="avatar avatar-xxl mb-3 mb-md-0 me-md-4">
                            {% if user.image %}
                                <img class="avatar-img rounded-circle border border-5 border-white shadow" 
                                     src="{{ asset('uploads/' ~ user.image) }}" 
                                     alt="avatar" 
                                     style="width: 150px; height: 150px; object-fit: cover;">
                            {% else %}
                                <img class="avatar-img rounded-circle border border-5 border-white shadow" 
                                     src="https://ui-avatars.com/api/?name={{ user.username }}&background=7c3aed&color=fff&size=150" 
                                     alt="avatar"
                                     style="width: 150px;">
                            {% endif %}
                        </div>
                        
                        <!-- Info -->
                        <div class="flex-grow-1">
                            <div class="d-flex flex-column flex-md-row justify-content-between align-items-center">
                                <div>
                                    <h1 class="h2 fw-bold mb-1" style="color: #1f1147;">{{ user.username }}</h1>
                                    <p class="text-muted mb-2">
                                        <i class="fas fa-envelope me-2"></i>{{ user.email }}
                                    </p>
                                    <div class="d-flex flex-wrap gap-2 justify-content-center justify-content-md-start">
                                        {% for role in user.roles %}
                                            {% if role == 'ROLE_ADMIN' %}
                                                <span class="badge rounded-pill bg-danger bg-opacity-10 text-danger px-3 py-2">
                                                    <i class="fas fa-crown me-1"></i> Administrateur
                                                </span>
                                            {% elseif role == 'ROLE_ENTREPRISE' %}
                                                <span class="badge rounded-pill bg-info bg-opacity-10 text-info px-3 py-2">
                                                    <i class="fas fa-building me-1"></i> Entreprise
                                                </span>
                                            {% else %}
                                                <span class="badge rounded-pill bg-primary bg-opacity-10 text-primary px-3 py-2">
                                                    <i class="fas fa-user me-1"></i> Utilisateur
                                                </span>
                                            {% endif %}
                                        {% endfor %}
                                        
                                        {% if user.isVerified %}
                                            <span class="badge rounded-pill bg-success bg-opacity-10 text-success px-3 py-2">
                                                <i class="fas fa-check-circle me-1"></i> Vérifié
                                            </span>
                                        {% else %}
                                            <span class="badge rounded-pill bg-warning bg-opacity-10 text-warning px-3 py-2">
                                                <i class="fas fa-clock me-1"></i> En attente
                                            </span>
                                        {% endif %}
                                    </div>
                                </div>
                                <div class="mt-3 mt-md-0">
                                    <a href="{{ path('app_user_edit', {'id': user.id, 'role': app.request.query.get('role')}) }}" class="btn btn-primary rounded-pill px-4 shadow-sm">
                                        <i class="fas fa-edit me-2"></i>Modifier le Profil
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Content Section -->
    <div class="container mt-4">
        <div class="row">
            <!-- Left Side: Stats & Details -->
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm mb-4" style="border-radius: 20px;">
                    <div class="card-header bg-transparent border-0 p-4 pb-0">
                        <h4 class="fw-bold" style="color: #1f1147;">Détails du Compte</h4>
                    </div>
                    <div class="card-body p-4">
                        <div class="row g-4">
                            <div class="col-sm-6">
                                <div class="p-3 bg-light rounded-4">
                                    <label class="small text-muted text-uppercase fw-bold mb-1">Nom Complet</label>
                                    <p class="h6 mb-0">{{ user.nom ?? 'Non renseigné' }}</p>
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="p-3 bg-light rounded-4">
                                    <label class="small text-muted text-uppercase fw-bold mb-1">Téléphone</label>
                                    <p class="h6 mb-0">{{ user.telephone ?? 'Non renseigné' }}</p>
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="p-3 bg-light rounded-4">
                                    <label class="small text-muted text-uppercase fw-bold mb-1">Date d'Inscription</label>
                                    <p class="h6 mb-0">{{ user.createdAt ? user.createdAt|date('d/m/Y') : 'N/A' }}</p>
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="p-3 bg-light rounded-4">
                                    <label class="small text-muted text-uppercase fw-bold mb-1">Solde Actuel</label>
                                    <p class="h6 mb-0 text-success fw-bold">{{ user.balance|default(0)|format_currency('TND') }}</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Recent Activities or Related Data -->
                <div class="card border-0 shadow-sm" style="border-radius: 20px;">
                    <div class="card-header bg-transparent border-0 p-4 pb-0 d-flex justify-content-between align-items-center">
                        <h4 class="fw-bold" style="color: #1f1147;">Activités Récentes</h4>
                        <span class="badge bg-primary rounded-pill">{{ user.candidatures|length }} Candidatures</span>
                    </div>
                    <div class="card-body p-4">
                        {% if user.candidatures|length > 0 %}
                            <div class="table-responsive">
                                <table class="table table-hover align-middle border-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th class="border-0 rounded-start">Appel d'Offre</th>
                                            <th class="border-0">Date</th>
                                            <th class="border-0 rounded-end">Statut</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {% for candidature in user.candidatures|slice(0, 5) %}
                                            <tr>
                                                <td>{{ candidature.appelOffre.titre }}</td>
                                                <td>{{ candidature.datePostulation|date('d/m/Y') }}</td>
                                                <td>
                                                    <span class="badge rounded-pill 
                                                        {{ candidature.statut == 'Acceptée' ? 'bg-success' : 
                                                           candidature.statut == 'Refusée' ? 'bg-danger' : 'bg-warning' }}">
                                                        {{ candidature.statut }}
                                                    </span>
                                                </td>
                                            </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        {% else %}
                            <div class="text-center py-4">
                                <img src="https://illustrations.popsy.co/purple/searching.svg" style="height: 120px;" alt="empty">
                                <p class="text-muted mt-3">Aucune activité récente trouvée.</p>
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>

            <!-- Right Side: Quick Actions & Security -->
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm mb-4" style="border-radius: 20px; background: #fdfcff;">
                    <div class="card-body p-4">
                        <h5 class="fw-bold mb-4">Actions d'Administration</h5>
                        <div class="d-grid gap-2">
                            <a href="{{ path('app_user_index', {'role': app.request.query.get('role')}) }}" class="btn btn-outline-secondary rounded-pill py-2">
                                <i class="fas fa-arrow-left me-2"></i>Liste des utilisateurs
                            </a>
                            <button class="btn btn-outline-info rounded-pill py-2">
                                <i class="fas fa-paper-plane me-2"></i>Envoyer un message
                            </button>
                            <hr class="my-3 opacity-10">
                            {{ include('user/_delete_form.html.twig') }}
                        </div>
                    </div>
                </div>

                <!-- Security Info -->
                <div class="card border-0 shadow-sm bg-dark text-white" style="border-radius: 20px;">
                    <div class="card-body p-4">
                        <h5 class="fw-bold mb-3">Sécurité du Compte</h5>
                        <ul class="list-unstyled small mb-0">
                            <li class="mb-3 d-flex align-items-center">
                                <i class="fas fa-check-circle text-success me-2 fs-5"></i>
                                <span>Double authentification (2FA) active</span>
                            </li>
                            <li class="mb-3 d-flex align-items-center">
                                <i class="fas fa-shield-alt text-primary me-2 fs-5"></i>
                                <span>Protection par pare-feu Finora</span>
                            </li>
                            <li class="d-flex align-items-center">
                                <i class="fas fa-clock text-warning me-2 fs-5"></i>
                                <span>Dernière connexion : Aujourd'hui</span>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}