{% extends app.request.query.get('role') == 'admin' ? 'admin_base.html.twig' : 'base.html.twig' %}

{% block title %}Nouvel Utilisateur{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <!-- Header -->
            <div class="mb-4">
                <a href="{{ path('app_user_index', {'role': app.request.query.get('role')}) }}" class="btn btn-link text-muted p-0 mb-2 text-decoration-none small">
                    <i class="fas fa-arrow-left me-1"></i> Retour à la liste
                </a>
                <h2 class="fw-bold mb-0" style="color: #1f1147;">Créer un Nouvel Utilisateur</h2>
                <p class="text-muted">Remplissez les informations ci-dessous pour ajouter un membre.</p>
            </div>

            <!-- Form Card -->
            <div class="card border-0 shadow-sm" style="border-radius: 25px;">
                <div class="card-body p-4 p-md-5">
                    {{ form_start(form, {'attr': {'class': 'needs-validation', 'novalidate': 'novalidate'}}) }}
                        <div class="row g-4">
                            <!-- Username -->
                            <div class="col-md-6">
                                <label class="form-label fw-bold small text-muted text-uppercase">Nom d'utilisateur</label>
                                {{ form_widget(form.username, {'attr': {'class': 'form-control bg-light border-0 py-2', 'placeholder': 'Ex: JeanDoe'}}) }}
                                {{ form_errors(form.username) }}
                            </div>

                            <!-- Email -->
                            <div class="col-md-6">
                                <label class="form-label fw-bold small text-muted text-uppercase">Adresse Email</label>
                                {{ form_widget(form.email, {'attr': {'class': 'form-control bg-light border-0 py-2', 'placeholder': 'email@example.com'}}) }}
                                {{ form_errors(form.email) }}
                            </div>

                            <!-- Phone -->
                            <div class="col-md-6">
                                <label class="form-label fw-bold small text-muted text-uppercase">Téléphone</label>
                                {{ form_widget(form.phone, {'attr': {'class': 'form-control bg-light border-0 py-2', 'placeholder': '+216 -- --- ---'}}) }}
                                {{ form_errors(form.phone) }}
                            </div>

                            <!-- Address -->
                            <div class="col-md-6">
                                <label class="form-label fw-bold small text-muted text-uppercase">Adresse</label>
                                {{ form_widget(form.address, {'attr': {'class': 'form-control bg-light border-0 py-2', 'placeholder': 'Ville, Pays'}}) }}
                                {{ form_errors(form.address) }}
                            </div>

                            <!-- Role -->
                            <div class="col-md-6">
                                <label class="form-label fw-bold small text-muted text-uppercase">Rôle / Type de compte</label>
                                {{ form_widget(form.role, {'attr': {'class': 'form-select bg-light border-0'}}) }}
                                {{ form_errors(form.role) }}
                            </div>

                            <!-- Password -->
                            <div class="col-md-6">
                                <label class="form-label fw-bold small text-muted text-uppercase">Mot de Passe</label>
                                {{ form_widget(form.password, {'attr': {'class': 'form-control bg-light border-0 py-2', 'placeholder': 'Minimum 6 caractères'}}) }}
                                {{ form_errors(form.password) }}
                            </div>

                            <!-- Image Upload -->
                            <div class="col-12">
                                <label class="form-label fw-bold small text-muted text-uppercase">Photo de Profil (Optionnel)</label>
                                {{ form_widget(form.image, {'attr': {'class': 'form-control bg-light border-0'}}) }}
                                {{ form_errors(form.image) }}
                            </div>

                            <!-- Actions -->
                            <div class="col-12 mt-5">
                                <div class="d-flex gap-3">
                                    <button type="submit" class="btn btn-primary rounded-pill px-5 py-2 shadow-sm">
                                        <i class="fas fa-user-plus me-2"></i>Créer l'utilisateur
                                    </button>
                                    <a href="{{ path('app_user_index', {'role': app.request.query.get('role')}) }}" class="btn btn-light rounded-pill px-4 py-2">
                                        Annuler
                                    </a>
                                </div>
                            </div>
                        </div>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}