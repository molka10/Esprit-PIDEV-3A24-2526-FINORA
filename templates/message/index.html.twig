{% extends 'base.html.twig' %}

{% block title %}Messages — FINORA{% endblock %}

{% block body %}
<div class="container-fluid py-4" style="height: calc(100vh - 100px);">
    <div class="row h-100 g-4">
        <!-- Sidebar: Contacts -->
        <div class="col-lg-4 col-xl-3 h-100">
            <div class="card border-0 shadow-sm h-100" style="border-radius: 20px;">
                <div class="card-header bg-white border-0 p-4">
                    <h5 class="fw-bold mb-0">Conversations</h5>
                    <div class="mt-3">
                        <input type="text" class="form-control form-control-sm bg-light border-0" placeholder="Rechercher un contact..." style="border-radius: 10px;">
                    </div>
                </div>
                <div class="card-body p-0 overflow-auto">
                    <div class="list-group list-group-flush" id="contactList">
                        {% for c in contacts %}
                            <a href="#" class="list-group-item list-group-item-action border-0 px-4 py-3 d-flex align-items-center contact-item" data-id="{{ c.user.id }}" data-name="{{ c.user.username }}">
                                <div class="avatar avatar-sm me-3">
                                    <img class="avatar-img rounded-circle" src="https://ui-avatars.com/api/?name={{ c.user.username }}&background=7c3aed&color=fff" alt="">
                                </div>
                                <div class="flex-grow-1 overflow-hidden">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <h6 class="mb-0 text-dark small fw-bold">{{ c.user.username }}</h6>
                                        <small class="text-muted" style="font-size: 10px;">{{ c.lastTime }}</small>
                                    </div>
                                    <p class="small text-muted mb-0 text-truncate">{{ c.lastMessage }}</p>
                                </div>
                            </a>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>

        <!-- Chat Area -->
        <div class="col-lg-8 col-xl-9 h-100">
            <div class="card border-0 shadow-sm h-100 d-flex flex-column" style="border-radius: 20px;">
                <!-- Chat Header -->
                <div class="card-header bg-white border-bottom p-4 d-flex align-items-center justify-content-between" id="chatHeader" style="display:none !important;">
                    <div class="d-flex align-items-center">
                        <div class="avatar avatar-sm me-3">
                            <img id="activeContactImg" class="avatar-img rounded-circle" src="" alt="">
                        </div>
                        <div>
                            <h6 class="mb-0 fw-bold" id="activeContactName"></h6>
                            <small class="text-success">En ligne</small>
                        </div>
                    </div>
                    <div>
                        <button class="btn btn-light btn-sm rounded-circle"><i class="bi bi-telephone"></i></button>
                        <button class="btn btn-light btn-sm rounded-circle ms-2"><i class="bi bi-info-circle"></i></button>
                    </div>
                </div>

                <!-- Chat Body (Messages) -->
                <div class="card-body p-4 overflow-auto flex-grow-1" id="chatBody" style="background: #f8fafc;">
                    <div class="h-100 d-flex flex-column align-items-center justify-content-center text-center opacity-50">
                        <i class="bi bi-chat-dots fs-1 mb-3"></i>
                        <h5>Sélectionnez une conversation</h5>
                        <p class="small">Commencez à discuter avec vos co-investisseurs ou partenaires.</p>
                    </div>
                </div>

                <!-- Chat Footer (Input) -->
                <div class="card-footer bg-white border-0 p-4" id="chatFooter" style="display:none !important;">
                    <div class="d-flex align-items-center bg-light p-2" style="border-radius: 15px;">
                        <button class="btn btn-link text-muted"><i class="bi bi-plus-circle fs-5"></i></button>
                        <input type="text" id="messageInput" class="form-control border-0 bg-transparent" placeholder="Tapez votre message ici...">
                        <button id="sendBtn" class="btn btn-primary rounded-circle ms-2 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px; background: var(--finora-gradient);">
                            <i class="bi bi-send-fill text-white"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .contact-item.active { background: rgba(124, 58, 237, 0.05); border-left: 3px solid #7c3aed !important; }
    .msg { max-width: 75%; padding: 12px 16px; border-radius: 15px; margin-bottom: 10px; position: relative; font-size: 14px; }
    .msg-mine { align-self: flex-end; background: #7c3aed; color: white; border-bottom-right-radius: 2px; }
    .msg-theirs { align-self: flex-start; background: white; color: #1e293b; border-bottom-left-radius: 2px; box-shadow: 0 2px 5px rgba(0,0,0,0.05); }
    .msg-time { font-size: 10px; opacity: 0.7; margin-top: 4px; display: block; text-align: right; }
</style>

<script>
document.addEventListener('DOMContentLoaded', () => {
    let activeReceiverId = null;
    const contactItems = document.querySelectorAll('.contact-item');
    const chatHeader = document.getElementById('chatHeader');
    const chatBody = document.getElementById('chatBody');
    const chatFooter = document.getElementById('chatFooter');
    const messageInput = document.getElementById('messageInput');
    const sendBtn = document.getElementById('sendBtn');

    contactItems.forEach(item => {
        item.addEventListener('click', (e) => {
            e.preventDefault();
            contactItems.forEach(i => i.classList.remove('active'));
            item.classList.add('active');

            activeReceiverId = item.getAttribute('data-id');
            const name = item.getAttribute('data-name');

            document.getElementById('activeContactName').textContent = name;
            document.getElementById('activeContactImg').src = `https://ui-avatars.com/api/?name=${name}&background=7c3aed&color=fff`;

            chatHeader.style.setProperty('display', 'flex', 'important');
            chatFooter.style.setProperty('display', 'block', 'important');

            loadMessages(activeReceiverId);
        });
    });

    async function loadMessages(id) {
        chatBody.innerHTML = '<div class="text-center mt-5"><div class="spinner-border text-primary"></div></div>';
        try {
            const response = await fetch(`/messages/conversation/${id}`);
            const messages = await response.json();
            
            chatBody.innerHTML = '<div class="d-flex flex-column"></div>';
            const container = chatBody.firstChild;

            messages.forEach(m => {
                const bubble = document.createElement('div');
                bubble.className = `msg ${m.isMine ? 'msg-mine' : 'msg-theirs'}`;
                bubble.innerHTML = `${m.content} <span class="msg-time">${m.createdAt}</span>`;
                container.appendChild(bubble);
            });

            chatBody.scrollTop = chatBody.scrollHeight;
        } catch (e) {
            chatBody.innerHTML = '<div class="alert alert-danger mx-4 mt-4">Erreur lors du chargement des messages.</div>';
        }
    }

    async function sendMessage() {
        const content = messageInput.value.trim();
        if (!content || !activeReceiverId) return;

        messageInput.value = '';

        // --- Optimistic UI Update ---
        const container = chatBody.querySelector('.d-flex.flex-column') || chatBody;
        const bubble = document.createElement('div');
        bubble.className = 'msg msg-mine';
        bubble.innerHTML = `${content.replace(/</g, '&lt;')} <span class="msg-time">À l'instant</span>`;
        container.appendChild(bubble);
        chatBody.scrollTop = chatBody.scrollHeight;
        // ----------------------------
        
        try {
            const response = await fetch('/messages/send', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ receiverId: activeReceiverId, content: content })
            });
            const result = await response.json();
            if (!result.success) {
                bubble.style.opacity = '0.5';
                alert('Erreur: ' + (result.message || 'Échec de l\'envoi'));
            }
        } catch (e) {
            bubble.style.opacity = '0.5';
            alert('Erreur réseau ou serveur : ' + e.message);
        }
    }

    sendBtn.addEventListener('click', sendMessage);
    messageInput.addEventListener('keypress', (e) => {
        if (e.key === 'Enter') sendMessage();
    });

    // --- Real-time Polling ---
    // Check for new messages every 5 seconds if a conversation is open
    setInterval(() => {
        if (activeReceiverId) {
            // We use a silent version of loadMessages to not show the spinner every 5s
            fetch(`/messages/conversation/${activeReceiverId}`)
                .then(res => res.json())
                .then(messages => {
                    const container = chatBody.querySelector('.d-flex.flex-column') || chatBody;
                    const currentCount = container.querySelectorAll('.msg').length;
                    
                    if (messages.length > currentCount) {
                        loadMessages(activeReceiverId); // Reload to get new messages properly
                    }
                });
        }
    }, 5000);
});
</script>
{% endblock %}
