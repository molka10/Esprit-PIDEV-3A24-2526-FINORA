{% extends 'base.html.twig' %}

{% block title %}Email envoyé - FINORA{% endblock %}

{% block body %}
<section class="p-0 overflow-hidden" style="min-height: 100vh;">
    <div class="row g-0 align-items-center h-100">
        <!-- Left side: Illustration -->
        <div class="col-lg-6 d-none d-lg-block vh-100 position-relative p-0" style="background: var(--finora-gradient-soft); border-right: 1px solid rgba(124, 58, 237, 0.1);">
            <div class="position-absolute top-50 start-50 translate-middle text-center w-75">
                <div class="mb-5">
                    <h2 class="fw-bold mb-3 h4" style="color: #6d28d9;">Vérifiez votre boîte mail</h2>
                    <p class="text-muted fs-5">Un email contenant un lien de réinitialisation vous a été envoyé si votre compte existe dans notre base.</p>
                </div>
                <img src="https://illustrations.popsy.co/purple/flying-mail.svg" class="w-75 px-5" alt="illustration">
            </div>
        </div>

        <!-- Right side: Content -->
        <div class="col-lg-6 vh-100 d-flex align-items-center justify-content-center bg-white p-4 p-sm-5">
            <div class="w-100 animate-in text-center" style="max-width: 450px;">
                <div class="bg-primary bg-opacity-10 p-4 rounded-circle d-inline-block mb-4">
                    <i class="bi bi-envelope-check text-primary fs-1"></i>
                </div>
                
                <h1 class="h2 fw-bold text-dark mb-3">Email envoyé ! ✉️</h1>
                <p class="text-muted mb-4">
                    Si un compte correspond à votre adresse, un email vient d'être envoyé. 
                    Ce lien expirera dans <strong>{{ resetToken.expirationMessageKey|trans(resetToken.expirationMessageData, 'ResetPasswordBundle') }}</strong>.
                </p>

                <div class="alert alert-warning small border-0 py-3" style="border-radius: 12px; background: rgba(255, 193, 7, 0.1);">
                    <i class="bi bi-info-circle me-2"></i>
                    Si vous ne recevez rien, vérifiez vos spams ou <a href="{{ path('app_forgot_password_request') }}" class="fw-bold text-dark">réessayez</a>.
                </div>

                <a href="{{ path('app_login') }}" class="btn btn-primary btn-lg w-100 py-3 mt-4 shadow" style="border-radius: 16px; font-weight: 700; background: linear-gradient(135deg, #7c3aed 0%, #3b1278 100%); border: none;">
                    RETOUR À LA CONNEXION
                </a>
            </div>
        </div>
    </div>
</section>
{% endblock %}
