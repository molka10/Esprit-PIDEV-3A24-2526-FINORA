{% extends 'base.html.twig' %}

{% block title %}Récupération de mot de passe - FINORA{% endblock %}

{% block body %}
<section class="p-0 overflow-hidden" style="min-height: 100vh;">
    <div class="row g-0 align-items-center h-100">
        <!-- Left side: Illustration (Desktop Only) -->
        <div class="col-lg-6 d-none d-lg-block vh-100 position-relative p-0" style="background: var(--finora-gradient-soft); border-right: 1px solid rgba(124, 58, 237, 0.1);">
            <div class="position-absolute top-50 start-50 translate-middle text-center w-75">
                <div class="mb-5">
                    <h2 class="fw-bold mb-3 h4" style="color: #6d28d9;">Pas de panique !</h2>
                    <p class="text-muted fs-5">Indiquez-nous votre email et nous vous enverrons un lien magique pour retrouver l'accès à votre compte.</p>
                </div>
                <img src="https://illustrations.popsy.co/purple/questions.svg" class="w-75 px-5" alt="illustration">
            </div>
        </div>

        <!-- Right side: Form -->
        <div class="col-lg-6 vh-100 d-flex align-items-center justify-content-center bg-white p-4 p-sm-5">
            <div class="w-100 animate-in" style="max-width: 450px;">
                <div class="mb-4">
                    <a href="{{ path('app_login') }}" class="text-muted text-decoration-none small fw-bold">
                        <i class="bi bi-arrow-left me-2"></i>Retour à la connexion
                    </a>
                </div>

                <h1 class="h2 fw-bold text-dark mb-1">Mot de passe oublié ? 🔐</h1>
                <p class="text-muted mb-4">Saisissez votre adresse email pour continuer.</p>

                {% for flash_error in app.flashes('reset_password_error') %}
                    <div class="alert alert-danger px-3 py-2 text-center small mb-4" style="border-radius: 12px;">
                        {{ flash_error }}
                    </div>
                {% endfor %}

                {{ form_start(requestForm, {'attr': {'novalidate': 'novalidate'}}) }}
                    <div class="mb-4">
                        <label class="form-label fw-bold small text-uppercase opacity-70">Votre Email</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-0 py-3"><i class="bi bi-envelope text-primary"></i></span>
                            {{ form_widget(requestForm.email, {
                                'attr': {
                                    'class': 'form-control bg-light border-0 py-3',
                                    'placeholder': 'votre@email.com',
                                    'style': 'border-radius: 0 12px 12px 0;'
                                }
                            }) }}
                        </div>
                        {{ form_errors(requestForm.email) }}
                    </div>

                    <button type="submit" class="btn btn-primary btn-lg w-100 py-3 mb-3 shadow" style="border-radius: 16px; font-weight: 700; background: linear-gradient(135deg, #7c3aed 0%, #3b1278 100%); border: none;">
                        ENVOYER LE LIEN
                    </button>
                {{ form_end(requestForm) }}

                <p class="text-center mt-4 mb-0 small text-muted">
                    Vous avez retrouvé votre mot de passe ? <a href="{{ path('app_login') }}" class="text-primary fw-bold">Se connecter</a>
                </p>
            </div>
        </div>
    </div>
</section>
{% endblock %}
