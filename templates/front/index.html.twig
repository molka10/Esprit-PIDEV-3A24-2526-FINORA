{% extends 'base.html.twig' %}

{% block title %}Finora - Votre Écosystème Financier Intelligent{% endblock %}

{% block body %}

<!-- =======================
Hero Section START -->
<section class="pro-hero text-white overflow-hidden">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-7 text-center text-lg-start" data-aos="fade-right">
                <h6 class="text-white bg-white bg-opacity-10 py-2 px-4 rounded-pill d-inline-block mb-4 fw-bold shadow-sm">
                    <i class="bi bi-shield-check me-2 text-primary"></i> Plateforme de Finance Intégrée
                </h6>
                <h1 class="display-3 fw-bold mb-4 animate-in" style="letter-spacing: -1.5px; line-height: 1.1;">
                    Maîtrisez votre <span class="text-gradient d-block d-sm-inline" style="background: linear-gradient(135deg, #c084fc 0%, #a78bfa 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">Liberté Financière</span>
                </h1>
                <p class="lead mb-5 opacity-75 animate-in" style="animation-delay: 0.1s; max-width: 600px; font-weight: 400;">
                    Apprenez, investissez et gérez votre patrimoine au même endroit. Une expérience premium conçue pour les esprits ambitieux et les futurs leaders de la finance.
                </p>
                <div class="d-flex flex-wrap justify-content-center justify-content-lg-start gap-4 animate-in" style="animation-delay: 0.2s;">
                    {% if app.user %}
                        <a href="{{ path('app_dashboard') }}" class="btn btn-premium btn-lg px-5 py-3 rounded-pill shadow-lg">
                            Accéder au Dashboard <i class="bi bi-arrow-right ms-2"></i>
                        </a>
                    {% else %}
                        <a href="{{ path('app_register') }}" class="btn btn-premium btn-lg px-5 py-3 rounded-pill shadow-lg">
                            Commencer l'Aventure <i class="bi bi-rocket-takeoff ms-2"></i>
                        </a>
                    {% endif %}
                    <a href="#decouvrez" class="btn btn-outline-light btn-lg rounded-pill px-5 border-2 hover-lift">Explorer les Modules</a>
                    <button onclick="startFinoraGuide()" class="btn btn-warning btn-lg rounded-pill px-4 shadow-lg ms-md-3">
                        <i class="bi bi-geo-alt-fill me-2"></i>Besoin d'aide ?
                    </button>
                </div>
            </div>
            <div class="col-lg-5 d-none d-lg-block" data-aos="zoom-in">
                <div class="position-relative">
                    <img src="{{ asset('assets/images/element/07.png') }}" class="img-fluid animate-float" alt="Finora Experience" style="filter: drop-shadow(0 20px 50px rgba(0,0,0,0.3));">
                    <div class="glass-card position-absolute bottom-0 start-0 p-3 m-4 d-none d-xl-block animate-float shadow-lg" style="animation-delay: 1s; backdrop-filter: blur(15px); border: 1px solid rgba(255,255,255,0.2);">
                        <h6 class="text-white mb-1 fw-bold"><i class="bi bi-cpu me-2 text-primary"></i> Trading IA Ready</h6>
                        <p class="small text-white opacity-75 mb-0">Algorithmes optimisés pour le marché tunisien.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Hero Section END -->

<!-- =======================
Découvrez FINORA Section (Modules) START -->
<section id="decouvrez" class="py-5 bg-white">
    <div class="container">
        <div class="row mb-5 text-center">
            <div class="col-lg-8 mx-auto">
                <span class="text-primary text-uppercase fw-bold small letter-spacing-1">Écosystème Intelligent</span>
                <h2 class="display-5 fw-bold mt-2">Découvrez <span class="text-primary">FINORA</span></h2>
                <p class="text-muted lead">Une solution tout-en-un pour éduquer, investir et gérer votre avenir financier.</p>
            </div>
        </div>
        
        <div id="tour-modules" class="row g-4 justify-content-center">
            <!-- Marché Boursier -->
            <div id="tour-market" class="col-md-6 col-lg-4" data-aos="fade-up" data-aos-delay="100">
                <div class="card h-100 p-4 border-0 shadow-sm card-hover text-center d-flex flex-column align-items-center" style="background: var(--finora-bg-purple); border-radius: 24px;">
                    <div class="mb-4" style="background: linear-gradient(135deg, #7c3aed, #a855f7); color: white; width: 70px; height: 70px; border-radius: 20px; display: flex; align-items: center; justify-content: center; font-size: 1.8rem; box-shadow: 0 10px 20px rgba(124, 58, 237, 0.2);">
                        <i class="bi bi-graph-up-arrow"></i>
                    </div>
                    <h4 class="fw-bold mb-3">Marché Boursier</h4>
                    <p class="text-muted small mb-4">Suivez le marché en direct (BVMT), analysez les graphiques avancés et gérez vos actifs boursiers avec précision.</p>
                    <a href="{% if app.user %}{{ path('app_market') }}{% else %}{{ path('app_login') }}{% endif %}" class="btn btn-primary rounded-pill px-5 mt-auto shadow-sm">{% if app.user %}Explorer{% else %}Se connecter{% endif %}</a>
                </div>
            </div>

            <!-- Wallet & Paiements -->
            <div id="tour-wallet" class="col-md-6 col-lg-4" data-aos="fade-up" data-aos-delay="200">
                <div class="card h-100 p-4 border-0 shadow-sm card-hover text-center d-flex flex-column align-items-center" style="background: var(--finora-bg-purple); border-radius: 24px;">
                    <div class="mb-4" style="background: linear-gradient(135deg, #db2777, #ec4899); color: white; width: 70px; height: 70px; border-radius: 20px; display: flex; align-items: center; justify-content: center; font-size: 1.8rem; box-shadow: 0 10px 20px rgba(219, 39, 119, 0.2);">
                        <i class="bi bi-wallet2"></i>
                    </div>
                    <h4 class="fw-bold mb-3">Wallet & Paiements</h4>
                    <p class="text-muted small mb-4">Centralisez vos revenus, contrôlez vos dépenses par catégories et optimisez votre budget mensuel en toute sécurité.</p>
                    <a href="{% if app.user %}{{ path('dashboard') }}{% else %}{{ path('app_login') }}{% endif %}" class="btn btn-primary rounded-pill px-5 mt-auto shadow-sm">Accéder</a>
                </div>
            </div>

            <!-- Formation & Quiz -->
            <div id="tour-formation" class="col-md-6 col-lg-4" data-aos="fade-up" data-aos-delay="300">
                <div class="card h-100 p-4 border-0 shadow-sm card-hover text-center d-flex flex-column align-items-center" style="background: var(--finora-bg-purple); border-radius: 24px;">
                    <div class="mb-4" style="background: linear-gradient(135deg, #0d9488, #14b8a6); color: white; width: 70px; height: 70px; border-radius: 20px; display: flex; align-items: center; justify-content: center; font-size: 1.8rem; box-shadow: 0 10px 20px rgba(13, 148, 136, 0.2);">
                        <i class="bi bi-mortarboard"></i>
                    </div>
                    <h4 class="fw-bold mb-3">Formation & Quiz</h4>
                    <p class="text-muted small mb-4">Apprenez la finance avec des experts, passez des certifications et validez vos acquis grâce à nos quiz interactifs.</p>
                    <a href="{% if app.user %}{{ path('app_formations') }}{% else %}{{ path('app_login') }}{% endif %}" class="btn btn-primary rounded-pill px-5 mt-auto shadow-sm">{% if app.user %}Apprendre{% else %}Accéder{% endif %}</a>
                </div>
            </div>

            <!-- Investissement -->
            <div class="col-md-6 col-lg-4" data-aos="fade-up" data-aos-delay="400">
                <div class="card h-100 p-4 border-0 shadow-sm card-hover text-center d-flex flex-column align-items-center" style="background: var(--finora-bg-purple); border-radius: 24px;">
                    <div class="mb-4" style="background: linear-gradient(135deg, #d97706, #f59e0b); color: white; width: 70px; height: 70px; border-radius: 20px; display: flex; align-items: center; justify-content: center; font-size: 1.8rem; box-shadow: 0 10px 20px rgba(217, 119, 6, 0.2);">
                        <i class="bi bi-building-up"></i>
                    </div>
                    <h4 class="fw-bold mb-3">Investissement</h4>
                    <p class="text-muted small mb-4">Découvrez des opportunités d'investissement exclusives et suivez la croissance de votre patrimoine sur le long terme.</p>
                    <a href="{% if app.user %}{{ path('app_investment_index') }}{% else %}{{ path('app_login') }}{% endif %}" class="btn btn-primary rounded-pill px-5 mt-auto shadow-sm">{% if app.user %}Investir{% else %}Découvrir{% endif %}</a>
                </div>
            </div>

            <!-- Appel d’offre / Candidature -->
            <div class="col-md-6 col-lg-4" data-aos="fade-up" data-aos-delay="500">
                <div class="card h-100 p-4 border-0 shadow-sm card-hover text-center d-flex flex-column align-items-center" style="background: var(--finora-bg-purple); border-radius: 24px;">
                    <div class="mb-4" style="background: linear-gradient(135deg, #2563eb, #3b82f6); color: white; width: 70px; height: 70px; border-radius: 20px; display: flex; align-items: center; justify-content: center; font-size: 1.8rem; box-shadow: 0 10px 20px rgba(37, 99, 235, 0.2);">
                        <i class="bi bi-megaphone"></i>
                    </div>
                    <h4 class="fw-bold mb-3">Recrutement & Offres</h4>
                    <p class="text-muted small mb-4">Publiez des appels d'offres ou postulez à des opportunités professionnelles au sein de la communauté FINORA.</p>
                    <a href="{% if app.user %}{{ path('app_appel_offre_index') }}{% else %}{{ path('app_login') }}{% endif %}" class="btn btn-primary rounded-pill px-5 mt-auto shadow-sm">{% if app.user %}Consulter{% else %}Voir offres{% endif %}</a>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Découvrez Section END -->

<!-- =======================
Bestsellers (Formations Populaires) Section START -->
<section class="py-5 bg-light">
    <div class="container">
        <!-- Title -->
        <div class="row mb-5 align-items-center text-center text-md-start">
            <div class="col-md-8">
                <span class="text-primary text-uppercase fw-bold small letter-spacing-1">Top Catalogue</span>
                <h2 class="mb-0 fw-bold display-6 mt-1">Formations <span class="text-primary">Vedettes</span></h2>
                <p class="text-muted lead fs-6">Les parcours les plus suivis par notre communauté d'experts.</p>
            </div>
            <div class="col-md-4 text-md-end mt-4 mt-md-0">
                <a href="{{ path('app_formations') }}" class="btn btn-outline-primary rounded-pill px-4 fw-bold">Voir tout le catalogue <i class="bi bi-arrow-right ms-2"></i></a>
            </div>
        </div>

        <div class="row g-4">
            {% for formation in bestsellers %}
                <div class="col-md-6 col-xl-4" data-aos="fade-up" data-aos-delay="{{ loop.index * 100 }}">
                    <div class="card card-hover shadow border-0 h-100 overflow-hidden bg-white" style="border-radius: 20px;">
                        <!-- Image -->
                        <div class="position-relative">
                            <img class="card-img-top" src="{{ formation.imageUrl ? (formation.imageUrl starts with 'http' ? formation.imageUrl : asset('uploads/formations/' ~ formation.imageUrl)) : 'https://images.pexels.com/photos/6694543/pexels-photo-6694543.jpeg?auto=compress&cs=tinysrgb&w=1260&h=750&dpr=1' }}" alt="{{ formation.titre }}" style="height: 220px; object-fit: cover;">
                            <div class="card-img-overlay d-flex align-items-start p-3">
                                <span class="badge bg-primary rounded-pill shadow-sm py-2 px-3 fw-bold">{{ formation.categorie }}</span>
                            </div>
                        </div>
                        <!-- Body -->
                        <div class="card-body p-4 d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <div class="text-warning small fw-bold">
                                    {% set rating = formation.rating|default(4.5) %}
                                    {% for i in 1..5 %}
                                        <i class="bi bi-star{{ (i <= rating) ? '-fill' : ((i - 0.5 <= rating) ? '-half' : '') }}"></i>
                                    {% endfor %}
                                    <span class="text-muted ms-1">({{ rating }})</span>
                                </div>
                                <span class="badge bg-success bg-opacity-10 text-success small py-1 px-2"><i class="bi bi-fire me-1"></i> Bestseller</span>
                            </div>
                            <h5 class="card-title fw-bold mb-3">
                                <a href="{{ path('app_formation_show', {id: formation.id}) }}" class="text-dark text-decoration-none hover-primary">{{ formation.titre }}</a>
                            </h5>
                            <p class="text-muted small mb-4 line-clamp-2" style="height: 40px; overflow: hidden;">{{ formation.description|striptags|slice(0, 100) }}...</p>
                            
                            <div class="mt-auto d-flex justify-content-between align-items-center pt-3 border-top">
                                <h4 class="text-primary fw-bold mb-0">{{ (formation.prix|default(0))|number_format(2, ',', ' ') }} DT</h4>
                                <a href="{{ path('app_formation_show', {id: formation.id}) }}" class="btn btn-sm btn-primary rounded-pill px-4 fw-bold shadow-sm">Commencer</a>
                            </div>
                        </div>
                    </div>
                </div>
            {% else %}
                <!-- Mock Data for Demonstration -->
                {% set mockFormations = [
                    {'t': 'Expertise en Bourse Tunisienne', 'd': 'Maîtrisez les spécificités de la BVMT et les stratégies de trading local.', 'p': '249.00'},
                    {'t': 'Gestion de Patrimoine Digital', 'd': 'Sécurisez vos actifs et optimisez vos flux financiers avec les outils modernes.', 'p': '189.00'},
                    {'t': 'Analyse Technique Avancée', 'd': 'Apprenez à lire les chandeliers, les indicateurs et à prévoir les tendances.', 'p': '299.00'}
                ] %}
                {% for mock in mockFormations %}
                <div class="col-md-6 col-xl-4">
                    <div class="card card-hover shadow border-0 h-100 overflow-hidden bg-white" style="border-radius: 20px;">
                        <div class="position-relative">
                            <img class="card-img-top" src="https://images.pexels.com/photos/6770610/pexels-photo-6770610.jpeg?auto=compress&cs=tinysrgb&w=1260&h=750&dpr=1" alt="Mock" style="height: 220px; object-fit: cover;">
                            <div class="card-img-overlay p-3"><span class="badge bg-secondary rounded-pill py-2 px-3 fw-bold">Finance</span></div>
                        </div>
                        <div class="card-body p-4 d-flex flex-column">
                            <h5 class="card-title fw-bold mb-3 text-dark">{{ mock.t }}</h5>
                            <p class="text-muted small mb-4">{{ mock.d }}</p>
                            <div class="mt-auto d-flex justify-content-between align-items-center pt-3 border-top">
                                <h4 class="text-primary fw-bold mb-0">{{ mock.p }} DT</h4>
                                <a href="#" class="btn btn-sm btn-primary rounded-pill px-4 disabled">Bientôt</a>
                            </div>
                        </div>
                    </div>
                </div>
                {% endfor %}
            {% endfor %}
        </div>
    </div>
</section>
<!-- Bestsellers Section END -->

<!-- =======================
ODD (Sustainable Development Goals) Section START -->
<section id="tour-odd" class="py-6 bg-white overflow-hidden">
    <div class="container">
        <div class="row mb-5 text-center">
            <div class="col-lg-8 mx-auto" data-aos="fade-up">
                <span class="text-primary text-uppercase fw-bold small letter-spacing-1">Impact Global</span>
                <h2 class="display-5 fw-bold mt-2">Engagés pour les <span class="text-primary">ODD</span></h2>
                <p class="text-muted lead">Finora aligne ses solutions financières avec les Objectifs de Développement Durable des Nations Unies pour un avenir plus juste et durable.</p>
            </div>
        </div>

        <div class="row g-3 justify-content-center">
            {% set odds = [
                {'id': 1, 'color': '#E5243B', 'title': 'Pas de pauvreté', 'icon': 'bi bi-bank'},
                {'id': 4, 'color': '#C5192D', 'title': 'Éducation de qualité', 'icon': 'bi bi-book'},
                {'id': 5, 'color': '#FF3A21', 'title': 'Égalité entre les sexes', 'icon': 'bi bi-gender-ambiguous'},
                {'id': 8, 'color': '#A21942', 'title': 'Travail décent et croissance', 'icon': 'bi bi-graph-up'},
                {'id': 9, 'color': '#FD6925', 'title': 'Industrie, innovation et infrastructure', 'icon': 'bi bi-cpu'},
                {'id': 10, 'color': '#DD1367', 'title': 'Inégalités réduites', 'icon': 'bi bi-people'},
                {'id': 12, 'color': '#BF8B2E', 'title': 'Consommation et production responsables', 'icon': 'bi bi-recycle'},
                {'id': 13, 'color': '#3F7E44', 'title': 'Mesures relatives à la lutte contre les changements climatiques', 'icon': 'bi bi-tree'},
                {'id': 17, 'color': '#19486A', 'title': 'Partenariats pour la réalisation des objectifs', 'icon': 'bi bi-globe'}
            ] %}

            {% for odd in odds %}
                <div class="col-6 col-sm-4 col-md-3 col-lg-2" data-aos="zoom-in" data-aos-delay="{{ loop.index * 50 }}">
                    <div class="odd-card text-center p-3 h-100 shadow-sm transition-all" style="border-radius: 15px; border-bottom: 5px solid {{ odd.color }}; background: #f8fafc;">
                        <div class="mb-2 d-inline-block p-2 rounded-circle" style="background: {{ odd.color }}20; color: {{ odd.color }};">
                            <i class="{{ odd.icon }} fs-3"></i>
                        </div>
                        <h6 class="small fw-bold mb-0 text-dark" style="font-size: 0.75rem;">{{ odd.title }}</h6>
                        <div class="mt-2 text-muted fw-bold" style="font-size: 0.65rem;">OBJECTIF {{ odd.id }}</div>
                    </div>
                </div>
            {% endfor %}
        </div>
        
        <div class="text-center mt-5" data-aos="fade-up">
            <p class="text-muted small">
                <i class="bi bi-info-circle me-2"></i> Finora intègre ces critères dans ses algorithmes d'IA pour favoriser l'investissement responsable.
            </p>
        </div>
    </div>
</section>

<style>
    .odd-card:hover {
        transform: translateY(-10px);
        box-shadow: 0 15px 30px rgba(0,0,0,0.1) !important;
        background: white !important;
    }
    .py-6 { padding-top: 5rem; padding-bottom: 5rem; }
    .letter-spacing-1 { letter-spacing: 1.5px; }
    .transition-all { transition: all 0.3s ease-in-out; }
</style>
<!-- ODD Section END -->

<!-- =======================
Stats Section START -->
<section class="py-5 bg-dark">
    <div class="container">
        <div class="row g-4 text-white text-center">
            <div class="col-md-4" data-aos="fade-up">
                <div class="p-3">
                    <i class="bi bi-patch-check fs-1 text-primary mb-3 d-block"></i>
                    <h2 class="purecounter display-6 fw-bold mb-0" data-purecounter-start="0" data-purecounter-end="{{ formationCount|default(12) }}" data-purecounter-delay="10">0</h2>
                    <p class="mb-0 text-muted text-uppercase small letter-spacing-1">Certifications Pro</p>
                </div>
            </div>
            <div class="col-md-4" data-aos="fade-up" data-aos-delay="100">
                <div class="p-3">
                    <i class="bi bi-people fs-1 text-primary mb-3 d-block"></i>
                    <h2 class="purecounter display-6 fw-bold mb-0" data-purecounter-start="0" data-purecounter-end="{{ userCount|default(1250) }}" data-purecounter-delay="10">0</h2>
                    <p class="mb-0 text-muted text-uppercase small letter-spacing-1">Membres Actifs</p>
                </div>
            </div>
            <div class="col-md-4" data-aos="fade-up" data-aos-delay="200">
                <div class="p-3">
                    <i class="bi bi-journal-check fs-1 text-primary mb-3 d-block"></i>
                    <h2 class="purecounter display-6 fw-bold mb-0" data-purecounter-start="0" data-purecounter-end="{{ lessonCount|default(85) }}" data-purecounter-delay="10">0</h2>
                    <p class="mb-0 text-muted text-uppercase small letter-spacing-1">Cours Interactifs</p>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Stats Section END -->

{% endblock %}
