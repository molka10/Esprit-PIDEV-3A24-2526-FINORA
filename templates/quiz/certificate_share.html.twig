<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Certificat FINORA — {{ quizResult.lessonTitle }}</title>
    <meta name="description" content="{{ quizResult.studentName }} a obtenu un Certificat d'Excellence FINORA pour la formation {{ quizResult.formationTitle }} avec un score de {{ quizResult.score }}%.">

    {# ── Open Graph (LinkedIn, Facebook, WhatsApp, etc.) ── #}
    <meta property="og:type"        content="website">
    <meta property="og:site_name"   content="FINORA">
    <meta property="og:title"       content="🎓 Certificat d'Excellence FINORA — {{ quizResult.lessonTitle }}">
    <meta property="og:description" content="{{ quizResult.studentName }} a réussi la formation {{ quizResult.formationTitle }} avec {{ quizResult.score }}% de réussite sur la plateforme financière FINORA.">
    <meta property="og:url"         content="{{ app.request.schemeAndHttpHost }}{{ app.request.requestUri }}">
    <meta property="og:image"       content="{{ app.request.schemeAndHttpHost }}/assets/images/logo-finora.webp">
    <meta property="og:image:width"  content="1200">
    <meta property="og:image:height" content="630">

    {# ── Twitter Card ── #}
    <meta name="twitter:card"        content="summary_large_image">
    <meta name="twitter:title"       content="🎓 Certificat FINORA — {{ quizResult.lessonTitle }}">
    <meta name="twitter:description" content="{{ quizResult.studentName }} — {{ quizResult.formationTitle }} — {{ quizResult.score }}%">
    <meta name="twitter:image"       content="{{ app.request.schemeAndHttpHost }}/assets/images/logo-finora.webp">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700;900&display=swap" rel="stylesheet">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Inter', sans-serif; background: #f0f4ff; display: flex; justify-content: center; align-items: center; min-height: 100vh; padding: 20px; }

        .cert-wrapper {
            background: white;
            border-radius: 24px;
            box-shadow: 0 30px 80px rgba(30,27,75,0.15);
            max-width: 680px;
            width: 100%;
            overflow: hidden;
        }
        .cert-header {
            background: linear-gradient(135deg, #1e1b4b 0%, #4c1d95 60%, #7c3aed 100%);
            padding: 40px;
            text-align: center;
            color: white;
        }
        .cert-header .badge-official {
            display: inline-block;
            border: 1px solid rgba(255,255,255,0.3);
            border-radius: 99px;
            padding: 6px 18px;
            font-size: 11px;
            font-weight: 800;
            letter-spacing: 2px;
            text-transform: uppercase;
            margin-bottom: 24px;
        }
        .cert-header img { width: 70px; height: 70px; border-radius: 50%; border: 3px solid rgba(255,255,255,0.4); background: white; padding: 8px; object-fit: contain; margin-bottom: 20px; }
        .cert-header .cert-type { font-size: 11px; font-weight: 800; letter-spacing: 3px; color: #fcd34d; text-transform: uppercase; margin-bottom: 10px; }
        .cert-header h1 { font-size: 28px; font-weight: 900; line-height: 1.2; }
        .cert-header p  { opacity: 0.75; margin-top: 10px; font-size: 15px; }

        .cert-body { padding: 40px; }
        .cert-student { text-align: center; margin-bottom: 30px; }
        .cert-student .label { font-size: 11px; color: #94a3b8; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; }
        .cert-student .name  { font-size: 26px; font-weight: 900; color: #1e1b4b; margin-top: 6px; }

        .divider { width: 80px; height: 3px; background: linear-gradient(90deg, transparent, #d4af37, transparent); margin: 0 auto 30px; }

        .cert-stats { display: flex; justify-content: center; gap: 40px; text-align: center; margin-bottom: 30px; }
        .stat-label { font-size: 10px; font-weight: 800; color: #94a3b8; letter-spacing: 1px; text-transform: uppercase; }
        .stat-value { font-size: 22px; font-weight: 900; color: #1e1b4b; margin-top: 4px; }
        .stat-value.green { color: #059669; }

        .cert-footer {
            background: #f8fafc;
            padding: 24px 40px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-top: 1px solid #e2e8f0;
        }
        .cert-footer .share-btns { display: flex; gap: 12px; }
        .btn-li  { background: #0077b5; color: white; border: none; border-radius: 12px; padding: 10px 20px; font-weight: 700; font-size: 14px; cursor: pointer; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; }
        .btn-fb  { background: #1877f2; color: white; border: none; border-radius: 12px; padding: 10px 20px; font-weight: 700; font-size: 14px; cursor: pointer; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; }
        .btn-dl  { background: #1e1b4b; color: white; border: none; border-radius: 12px; padding: 10px 20px; font-weight: 700; font-size: 14px; cursor: pointer; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; }
        .verified { display: flex; align-items: center; gap: 8px; color: #059669; font-size: 13px; font-weight: 700; }
    </style>
</head>
<body>
    <div class="cert-wrapper">
        <div class="cert-header">
            <div class="badge-official">✦ FINORA OFFICIAL</div><br>
            <img src="/assets/images/logo-finora.webp" alt="Finora Logo">
            <div class="cert-type">Certificat d'Excellence</div>
            <h1>{{ quizResult.lessonTitle }}</h1>
            <p>Délivré pour la formation <strong>{{ quizResult.formationTitle }}</strong></p>
        </div>

        <div class="cert-body">
            <div class="cert-student">
                <div class="label">Décerné à</div>
                <div class="name">{{ quizResult.studentName }}</div>
            </div>
            <div class="divider"></div>
            <div class="cert-stats">
                <div>
                    <div class="stat-label">Score</div>
                    <div class="stat-value green">{{ quizResult.score }}%</div>
                </div>
                <div>
                    <div class="stat-label">Date</div>
                    <div class="stat-value">{{ quizResult.takenAt|date('d M Y') }}</div>
                </div>
                <div>
                    <div class="stat-label">Statut</div>
                    <div class="stat-value green">✓ Validé</div>
                </div>
            </div>
        </div>

        <div class="cert-footer">
            <div class="verified">✔ Certificat Vérifié par FINORA</div>
            <div class="share-btns">
                <a href="https://www.linkedin.com/feed/?shareActive=true&text={{ ('🎓 Je viens d\'obtenir mon Certificat d\'Excellence FINORA !\n\n✅ Formation : ' ~ quizResult.formationTitle ~ '\n📘 Leçon : ' ~ quizResult.lessonTitle ~ '\n🏆 Score : ' ~ quizResult.score ~ '%\n\n👉 ' ~ app.request.schemeAndHttpHost ~ app.request.requestUri ~ '\n\n#Finora #Certificat #Finance #Formation #ESPRIT')|url_encode }}" target="_blank" class="btn-li">
                    <svg width="16" height="16" fill="white" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
                    LinkedIn
                </a>
                <a href="javascript:void(0)" onclick="copyAndOpenFacebook()" class="btn-fb">
                    <svg width="16" height="16" fill="white" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
                    Facebook
                </a>
                <a href="{{ path('app_quiz_certificate', {id: quizResult.id}) }}" class="btn-dl">
                    ⬇ PDF
                </a>
            </div>
        </div>
    </div>

    <script>
    function copyAndOpenFacebook() {
        const text = `🎓 Je viens d'obtenir mon Certificat d'Excellence FINORA !\n\n✅ Formation : {{ quizResult.formationTitle|escape('js') }}\n📘 Leçon : {{ quizResult.lessonTitle|escape('js') }}\n🏆 Score : {{ quizResult.score }}%\n\n👉 {{ app.request.schemeAndHttpHost }}{{ app.request.requestUri }}\n\n#Finora #Certificat #Finance #Formation`;
        navigator.clipboard.writeText(text).then(() => {
            alert('✅ Texte copié ! Ouvrez Facebook, créez un post et collez le texte. Ajoutez aussi la photo du certificat !');
            window.open('https://www.facebook.com/', '_blank');
        });
    }
    </script>
</body>
</html>
