<!DOCTYPE html>
<html lang="en" data-bs-theme="light">

<head>
	<title>FINORA - Admin Dashboard</title>

	<!-- Meta Tags -->
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
	<meta name="author" content="Finora">
	<meta name="description" content="Finora Admin Dashboard">

	<!-- Dark mode -->


	<!-- Favicon -->
	<link rel="shortcut icon" href="{{ asset('assets/images/favicon.ico') }}">

	<!-- Google Font -->
	<link rel="preconnect" href="https://fonts.googleapis.com/">
	<link rel="preconnect" href="https://fonts.gstatic.com/" crossorigin>
	<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Heebo:wght@400;500;700&amp;family=Roboto:wght@400;500;700&amp;display=swap">

	<!-- Plugins CSS -->
	<link rel="stylesheet" type="text/css" href="{{ asset('assets/vendor/font-awesome/css/all.min.css') }}">
	<link rel="stylesheet" type="text/css" href="{{ asset('assets/vendor/bootstrap-icons/bootstrap-icons.css') }}">
	<link rel="stylesheet" type="text/css" href="{{ asset('assets/vendor/apexcharts/css/apexcharts.css') }}">
	<link rel="stylesheet" type="text/css" href="{{ asset('assets/vendor/overlay-scrollbar/css/overlayscrollbars.min.css') }}">

	<!-- Theme CSS -->
	<link rel="stylesheet" type="text/css" href="{{ asset('assets/css/style.css') }}">

	{% block stylesheets %}{% endblock %}
</head>

<body>


<!-- **************** MAIN CONTENT START **************** -->
<main>
	
<!-- Sidebar START -->
<nav class="navbar sidebar navbar-expand-xl navbar-dark bg-dark">

	<!-- Navbar brand for xl START -->
	<div class="d-flex align-items-center">
		<a class="navbar-brand" href="{{ path('app_admin') }}">
			<img class="navbar-brand-item" src="{{ asset('assets/images/logo-finora.webp') }}" alt="FINORA" style="height:40px; filter: brightness(0) invert(1);">
		</a>
	</div>
	<!-- Navbar brand for xl END -->
	
	<div class="offcanvas offcanvas-start flex-row custom-scrollbar h-100" data-bs-backdrop="true" tabindex="-1" id="offcanvasSidebar">
		<div class="offcanvas-body sidebar-content d-flex flex-column bg-dark">

			<!-- Sidebar menu START -->
			<ul class="navbar-nav flex-column" id="navbar-sidebar">
				
				<!-- Menu item 1 -->
				<li class="nav-item">
                    <a href="{{ path('app_admin') }}" class="nav-link {% if app.request.attributes.get('_route') == 'app_admin' %}active{% endif %}">
                        <i class="bi bi-house fa-fw me-2"></i>Dashboard
                    </a>
                </li>
				
				<!-- Title -->
				<li class="nav-item ms-2 my-2">Pages</li>

				<li class="nav-item"> 
                    <a class="nav-link {% if app.request.attributes.get('_route') starts with 'admin_user_' %}active{% endif %}" href="{{ path('admin_user_index') }}">
                        <i class="fas fa-users fa-fw me-2"></i>Users
                    </a>
                </li>

				<!-- Title -->
				<li class="nav-item ms-2 my-2">Bourse</li>

                <!-- Collapsible Bourse Menu -->
                <li class="nav-item">
                    <a class="nav-link d-flex align-items-center {% if app.request.attributes.get('_route') starts with 'app_bourse_' or app.request.attributes.get('_route') starts with 'app_action_' or app.request.attributes.get('_route') == 'app_admin_bourse_transactions' %}active{% endif %}" data-bs-toggle="collapse" href="#collapseBourse" role="button" aria-expanded="false" aria-controls="collapseBourse">
                        <i class="bi bi-graph-up fa-fw me-2"></i>Gestion Bourse
                        <i class="fas fa-chevron-down ms-auto" style="font-size: 0.8em;"></i>
                    </a>
                    <div class="collapse {% if app.request.attributes.get('_route') starts with 'app_bourse_' or app.request.attributes.get('_route') starts with 'app_action_' or app.request.attributes.get('_route') == 'app_admin_bourse_transactions' %}show{% endif %}" id="collapseBourse">
                        <ul class="nav flex-column ms-4 border-start border-secondary">
                            <li class="nav-item">
                                <a class="nav-link py-1 {% if app.request.attributes.get('_route') == 'app_bourse_admin' %}active{% endif %}" href="{{ path('app_bourse_admin') }}">
                                    <i class="bi bi-grid-fill fa-fw me-2" style="font-size: 0.9em;"></i>Dashboard Bourse
                                </a>
                            </li>
                            <li class="nav-item mt-1">
                                <a class="nav-link py-1 {% if app.request.attributes.get('_route') starts with 'app_action_' %}active{% endif %}" href="{{ path('app_action_index') }}">
                                    <i class="bi bi-briefcase fa-fw me-2" style="font-size: 0.9em;"></i>Gérer Actions
                                </a>
                            </li>
                            <li class="nav-item mt-1">
                                <a class="nav-link py-1 {% if app.request.attributes.get('_route') starts with 'app_bourse_' and app.request.attributes.get('_route') != 'app_bourse_admin' %}active{% endif %}" href="{{ path('app_bourse_index') }}">
                                    <i class="bi bi-currency-exchange fa-fw me-2" style="font-size: 0.9em;"></i>Gérer Bourses
                                </a>
                            </li>
                            <li class="nav-item mt-1 mb-2">
                                <a class="nav-link py-1 {% if app.request.attributes.get('_route') == 'app_admin_bourse_transactions' %}active{% endif %}" href="{{ path('app_admin_bourse_transactions') }}">
                                    <i class="bi bi-receipt fa-fw me-2" style="font-size: 0.9em;"></i>Transactions
                                </a>
                            </li>
                        </ul>
                    </div>
                </li>

				<!-- Title -->
				<li class="nav-item ms-2 my-2">Formations</li>

                <!-- Collapsible Formations Menu -->
                <li class="nav-item">
                    <a class="nav-link d-flex align-items-center {% if app.request.attributes.get('_route') starts with 'admin_formation' or app.request.attributes.get('_route') starts with 'app_lesson' or app.request.attributes.get('_route') == 'app_admin_quiz_results' or app.request.attributes.get('_route') starts with 'admin_centres' %}active{% endif %}" data-bs-toggle="collapse" href="#collapseFormations" role="button" aria-expanded="false" aria-controls="collapseFormations">
                        <i class="bi bi-basket fa-fw me-2"></i>Espace Formations
                        <i class="fas fa-chevron-down ms-auto" style="font-size: 0.8em;"></i>
                    </a>
                    <div class="collapse {% if app.request.attributes.get('_route') starts with 'admin_formation' or app.request.attributes.get('_route') starts with 'app_lesson' or app.request.attributes.get('_route') == 'app_admin_quiz_results' or app.request.attributes.get('_route') starts with 'admin_centres' %}show{% endif %}" id="collapseFormations">
                        <ul class="nav flex-column ms-4 border-start border-secondary">
                            <li class="nav-item">
                                <a class="nav-link py-1 {% if app.request.attributes.get('_route') == 'admin_formation_index' %}active{% endif %}" href="{{ path('admin_formation_index') }}">
                                    <i class="fas fa-layer-group fa-fw me-2" style="font-size: 0.9em;"></i>Toutes les Formations
                                </a>
                            </li>
                            <li class="nav-item mt-1">
                                <a class="nav-link py-1 {% if app.request.attributes.get('_route') == 'app_lesson_index' %}active{% endif %}" href="{{ path('app_lesson_index') }}">
                                    <i class="fas fa-book fa-fw me-2" style="font-size: 0.9em;"></i>Gérer les Leçons
                                </a>
                            </li>
                            <li class="nav-item mt-1">
                                <a class="nav-link py-1 {% if app.request.attributes.get('_route') == 'app_admin_quiz_results' %}active{% endif %}" href="{{ path('app_admin_quiz_results') }}">
                                    <i class="fas fa-poll fa-fw me-2" style="font-size: 0.9em;"></i>Résultats des Quizz
                                </a>
                            </li>
                            <li class="nav-item mt-1 mb-2">
                                <a class="nav-link py-1 {% if app.request.attributes.get('_route') == 'admin_centres_index' %}active{% endif %}" href="{{ path('admin_centres_index') }}">
                                    <i class="fas fa-map-marked-alt fa-fw me-2" style="font-size: 0.9em;"></i>Centres de Formations
                                </a>
                            </li>
                        </ul>
                    </div>
                </li>

				<!-- Title -->
				{% if is_granted('ROLE_ADMIN') %}
				<li class="nav-item ms-2 my-2">Investissement</li>

                <!-- Collapsible Investissement Menu -->
                <li class="nav-item">
                    <a class="nav-link d-flex align-items-center {% if app.request.attributes.get('_route') starts with 'admin_investment' %}active{% endif %}" data-bs-toggle="collapse" href="#collapseInvestment" role="button" aria-expanded="false" aria-controls="collapseInvestment">
                        <i class="bi bi-wallet2 fa-fw me-2"></i>Espace Investissement
                        <i class="fas fa-chevron-down ms-auto" style="font-size: 0.8em;"></i>
                    </a>
                    <div class="collapse {% if app.request.attributes.get('_route') starts with 'admin_investment' %}show{% endif %}" id="collapseInvestment">
                        <ul class="nav flex-column ms-4 border-start border-secondary">
                            <li class="nav-item">
                                <a class="nav-link py-1 {% if app.request.attributes.get('_route') == 'admin_investment_index' %}active{% endif %}" href="{{ path('admin_investment_index') }}">
                                    <i class="bi bi-grid-fill fa-fw me-2" style="font-size: 0.9em;"></i>Tous les Projets
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link py-1 {% if app.request.attributes.get('_route') == 'admin_investment_moderation' %}active{% endif %}" href="{{ path('admin_investment_moderation') }}">
                                    <i class="bi bi-shield-check fa-fw me-2 text-warning" style="font-size: 0.9em;"></i>Modération
                                </a>
                            </li>
                            <li class="nav-item mt-1">
                                <a class="nav-link py-1 {% if app.request.attributes.get('_route') == 'admin_investment_management_list' %}active{% endif %}" href="{{ path('admin_investment_management_list') }}">
                                    <i class="bi bi-people-fill fa-fw me-2" style="font-size: 0.9em;"></i>Participations
                                </a>
                            </li>
                            <li class="nav-item mt-1 mb-2">
                                <a class="nav-link py-1 {% if app.request.attributes.get('_route') == 'admin_investment_new' %}active{% endif %}" href="{{ path('admin_investment_new') }}">
                                    <i class="bi bi-plus-circle-fill fa-fw me-2" style="font-size: 0.9em;"></i>Nouveau Projet
                                </a>
                            </li>
                        </ul>
                    </div>
                </li>
				{% endif %}

				<!-- Title -->
				<li class="nav-item ms-2 my-2">Wallet</li>

                <!-- Collapsible Wallet Menu -->
                <li class="nav-item">
                    <a class="nav-link d-flex align-items-center {% if app.request.attributes.get('_route') starts with 'app_admin_wallet' or app.request.attributes.get('_route') starts with 'wallet_' %}active{% endif %}" data-bs-toggle="collapse" href="#collapseWallet" role="button" aria-expanded="false" aria-controls="collapseWallet">
                        <i class="bi bi-wallet2 fa-fw me-2"></i>Espace Wallet
                        <i class="fas fa-chevron-down ms-auto" style="font-size: 0.8em;"></i>
                    </a>
                    <div class="collapse {% if app.request.attributes.get('_route') starts with 'app_admin_wallet' or app.request.attributes.get('_route') starts with 'wallet_' %}show{% endif %}" id="collapseWallet">
                        <ul class="nav flex-column ms-4 border-start border-secondary">
                            <li class="nav-item">
                                <a class="nav-link py-1 {% if app.request.attributes.get('_route') == 'app_admin_wallet' %}active{% endif %}" href="{{ path('app_admin_wallet') }}">
                                    <i class="bi bi-grid-fill fa-fw me-2" style="font-size: 0.9em;"></i>Dashboard Wallet
                                </a>
                            </li>
                            <li class="nav-item mt-1">
                                <a class="nav-link py-1 {% if app.request.attributes.get('_route') == 'wallet_admin_fraud_audit' %}active{% endif %}" href="{{ path('wallet_admin_fraud_audit') }}">
                                    <i class="bi bi-shield-exclamation fa-fw me-2 text-warning" style="font-size: 0.9em;"></i>Audit Fraudes
                                </a>
                            </li>
                            <li class="nav-item mt-1">
                                <a class="nav-link py-1 {% if app.request.attributes.get('_route') == 'wallet_admin_categories' %}active{% endif %}" href="{{ path('wallet_admin_categories') }}">
                                    <i class="bi bi-tags fa-fw me-2" style="font-size: 0.9em;"></i>Gestions Catégories
                                </a>
                            </li>
                            <li class="nav-item mt-1 mb-2">
                                <a class="nav-link py-1 {% if app.request.attributes.get('_route') == 'wallet_admin_cards' %}active{% endif %}" href="{{ path('wallet_admin_cards') }}">
                                    <i class="bi bi-credit-card fa-fw me-2" style="font-size: 0.9em;"></i>Cartes Bancaires
                                </a>
                            </li>
                        </ul>
                    </div>
                </li>
				
				<!-- Title -->
				<li class="nav-item ms-2 my-2">Appels d'Offre</li>

                <!-- Collapsible Appel d'Offre Menu -->
                <li class="nav-item">
                    <a class="nav-link d-flex align-items-center {% if app.request.attributes.get('_route') starts with 'app_appel_offre_' or app.request.attributes.get('_route') starts with 'app_candidature_' or app.request.attributes.get('_route') starts with 'app_categorie_' %}active{% endif %}" data-bs-toggle="collapse" href="#collapseAppel" role="button" aria-expanded="false" aria-controls="collapseAppel">
                        <i class="bi bi-file-earmark-text fa-fw me-2"></i>Espace Appels d'Offres
                        <i class="fas fa-chevron-down ms-auto" style="font-size: 0.8em;"></i>
                    </a>
                    <div class="collapse {% if app.request.attributes.get('_route') starts with 'app_appel_offre_' or app.request.attributes.get('_route') starts with 'app_candidature_' or app.request.attributes.get('_route') starts with 'app_categorie_' or app.request.attributes.get('_route') == 'app_admin_dashboard' %}show{% endif %}" id="collapseAppel">
                        <ul class="nav flex-column ms-4 border-start border-secondary">
                            <li class="nav-item">
                                <a class="nav-link py-1 {% if app.request.attributes.get('_route') == 'app_admin_dashboard' %}active{% endif %}" href="{{ path('app_admin_dashboard') }}">
                                    <i class="bi bi-speedometer2 fa-fw me-2" style="font-size: 0.9em;"></i>Tableau de Bord
                                </a>
                            </li>
                            <li class="nav-item mt-1">
                                <a class="nav-link py-1 {% if app.request.attributes.get('_route') == 'app_appel_offre_index' %}active{% endif %}" href="{{ path('app_appel_offre_index', {'role': 'admin'}) }}">
                                    <i class="bi bi-grid-fill fa-fw me-2" style="font-size: 0.9em;"></i>Toutes les Offres
                                </a>
                            </li>
                            <li class="nav-item mt-1">
                                <a class="nav-link py-1 {% if app.request.attributes.get('_route') == 'app_candidature_index' %}active{% endif %}" href="{{ path('app_candidature_index', {'role': 'admin'}) }}">
                                    <i class="bi bi-people fa-fw me-2" style="font-size: 0.9em;"></i>Candidatures
                                </a>
                            </li>
                            <li class="nav-item mt-1 mb-2">
                                <a class="nav-link py-1 {% if app.request.attributes.get('_route') == 'app_categorie_index' %}active{% endif %}" href="{{ path('app_categorie_index', {'role': 'admin'}) }}">
                                    <i class="bi bi-tags fa-fw me-2" style="font-size: 0.9em;"></i>Gérer Catégories
                                </a>
                            </li>
                        </ul>
                    </div>
                </li>

			</ul>
			<!-- Sidebar menu end -->

			<!-- Sidebar footer START -->
			<div class="px-3 mt-auto pt-3">
				<div class="d-flex align-items-center justify-content-between text-primary-hover">
						<a class="h5 mb-0 text-body" href="{{ path('app_home') }}" data-bs-toggle="tooltip" data-bs-placement="top" title="Home">
							<i class="bi bi-globe"></i>
						</a>
						<a class="h5 mb-0 text-body" href="{{ path('app_profile') }}" data-bs-toggle="tooltip" data-bs-placement="top" title="My Profile">
							<i class="bi bi-person-fill"></i>
						</a>
						<a class="h5 mb-0 text-body" href="{{ path('app_logout') }}" data-bs-toggle="tooltip" data-bs-placement="top" title="Sign out">
							<i class="bi bi-power"></i>
						</a>
				</div>
			</div>
			<!-- Sidebar footer END -->
			
		</div>
	</div>
</nav>
<!-- Sidebar END -->

<!-- Page content START -->
<div class="page-content">

	<!-- Top bar START -->
	<nav class="navbar top-bar navbar-light border-bottom py-0 py-xl-3">
		<div class="container-fluid p-0">
			<div class="d-flex align-items-center w-100">

				<!-- Logo START -->
				<div class="d-flex align-items-center d-xl-none">
					<a class="navbar-brand" href="{{ path('app_admin') }}">
						<img class="light-mode-item navbar-brand-item h-30px" src="{{ asset('assets/images/logo-finora.webp') }}" alt="FINORA">
						<img class="navbar-brand-item h-30px" src="{{ asset('assets/images/logo-finora.webp') }}" alt="FINORA" style="filter: brightness(0) invert(1);">
					</a>
				</div>
				<!-- Logo END -->

				<!-- Toggler for sidebar START -->
				<div class="navbar-expand-xl sidebar-offcanvas-menu">
					<button class="navbar-toggler me-auto" type="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvasSidebar" aria-controls="offcanvasSidebar" aria-expanded="false" aria-label="Toggle navigation" data-bs-auto-close="outside">
						<i class="bi bi-text-right fa-fw h2 lh-0 mb-0 rtl-flip" data-bs-target="#offcanvasMenu"> </i>
					</button>
				</div>
				<!-- Toggler for sidebar END -->
				
				<!-- Top bar left -->
				<div class="navbar-expand-lg ms-auto ms-xl-0">
					
					<!-- Toggler for menubar START -->
					<button class="navbar-toggler ms-auto" type="button" data-bs-toggle="collapse" data-bs-target="#navbarTopContent" aria-controls="navbarTopContent" aria-expanded="false" aria-label="Toggle navigation">
						<span class="navbar-toggler-animation">
							<span></span>
							<span></span>
							<span></span>
						</span>
					</button>
					<!-- Toggler for menubar END -->

				</div>
				<!-- Top bar left END -->
				
				<!-- Top bar right START -->
				<div class="ms-xl-auto">
					<ul class="navbar-nav flex-row align-items-center">

						<!-- Profile dropdown START -->
						<li class="nav-item ms-2 ms-md-3 dropdown">
							<!-- Avatar -->
							<a class="avatar avatar-sm p-0" href="#" id="profileDropdown" role="button" data-bs-auto-close="outside" data-bs-display="static" data-bs-toggle="dropdown" aria-expanded="false">
                                {% if app.user %}
                                    {% if app.user.image %}
                                        <img class="avatar-img rounded-circle" src="{{ asset('uploads/' ~ app.user.image) }}" alt="avatar">
                                    {% else %}
                                        <img class="avatar-img rounded-circle" src="https://ui-avatars.com/api/?name={{ app.user.username }}" alt="avatar">
                                    {% endif %}
                                {% endif %}
							</a>

							<!-- Profile dropdown START -->
							<ul class="dropdown-menu dropdown-animation dropdown-menu-end shadow pt-3" aria-labelledby="profileDropdown">
								<!-- Profile info -->
								<li class="px-3">
									<div class="d-flex align-items-center">
										<!-- Avatar -->
										<div class="avatar me-3 mb-3">
                                            {% if app.user %}
                                                {% if app.user.image %}
                                                    <img class="avatar-img rounded-circle shadow" src="{{ asset('uploads/' ~ app.user.image) }}" alt="avatar">
                                                {% else %}
                                                    <img class="avatar-img rounded-circle shadow" src="https://ui-avatars.com/api/?name={{ app.user.username }}" alt="avatar">
                                                {% endif %}
                                            {% endif %}
										</div>
										<div>
											<a class="h6 mt-2 mt-sm-0" href="#">
                                                {{ app.user ? app.user.username : 'Guest' }}
                                                <i class="bi bi-patch-check-fill text-primary ms-1" style="font-size: 14px;" data-bs-toggle="tooltip" title="Administrateur Certifié"></i>
                                            </a>
											<p class="small m-0">{{ app.user ? app.user.email : '' }}</p>
										</div>
									</div>
								</li>
                                <li> <hr class="dropdown-divider"></li>
								<!-- Links -->
								<li><a class="dropdown-item" href="{{ path('app_profile') }}"><i class="bi bi-person fa-fw me-2"></i>My Profile</a></li>
								<li><a class="dropdown-item bg-danger-soft-hover" href="{{ path('app_logout') }}"><i class="bi bi-power fa-fw me-2"></i>Sign Out</a></li>
								<li> <hr class="dropdown-divider"></li>

								<!-- Dark mode options START -->
 
								<!-- Dark mode options END-->
							</ul>
							<!-- Profile dropdown END -->
						</li>
						<!-- Profile dropdown END -->
					</ul>
				</div>
				<!-- Top bar right END -->
			</div>
		</div>
	</nav>
	<!-- Top bar END -->

	<!-- Page main content START -->
	<div class="page-content-wrapper border" style="min-height: 80vh;">
        <div class="container-fluid">
		    {% block body %}{% endblock %}
        </div>
	</div>
	<!-- Page main content END -->
</div>
<!-- Page content END -->

</main>
<!-- **************** MAIN CONTENT END **************** -->

<!-- Back to top -->
<div class="back-top"><i class="bi bi-arrow-up-short position-absolute top-50 start-50 translate-middle"></i></div>

<!-- Bootstrap JS -->
<script src="{{ asset('assets/vendor/bootstrap/dist/js/bootstrap.bundle.min.js') }}"></script>

<!-- Vendors -->
<script src="{{ asset('assets/vendor/purecounterjs/dist/purecounter_vanilla.js') }}"></script>
{# <script src="{{ asset('assets/vendor/apexcharts/js/apexcharts.min.js') }}"></script> #}
<script src="{{ asset('assets/vendor/overlay-scrollbar/js/overlayscrollbars.min.js') }}"></script>

<!-- Template Functions -->
<script src="{{ asset('assets/js/functions.js') }}"></script>

{% block javascripts %}{% endblock %}

</body>
</html>