<div class="row g-4" id="project-list-container" data-total-count="{{ investments.getTotalItemCount() }}">
    {% for investment in investments %}
    <div class="col-md-6 col-lg-4">
        <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden transition-all hover-shadow-lg bg-white" style="animation-delay: {{ loop.index0 * 100 }}ms;">
            <!-- Image Catalog -->
            <div class="position-relative">
                <img src="{{ investment_image_src(investment) ?: asset('assets/images/courses/4by3/06.jpg') }}" 
                     class="card-img-top" style="height: 190px; object-fit: cover;" alt="">
                
                <div class="position-absolute top-0 start-0 p-3 d-flex gap-2">
                    <span class="badge rounded-pill bg-success px-3 py-2 shadow-sm" style="font-size: 0.65rem; background: #10b981 !important;">EN COURS</span>
                </div>


            </div>
            
            <!-- Catalog Info -->
            <div class="card-body p-4 d-flex flex-column">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-primary-light fw-bold text-uppercase" style="font-size: 0.65rem; color: #7c3aed !important; letter-spacing: 0.5px;">
                        {{ investment_category_label(investment.category) }}
                    </span>
                    <span class="text-muted small"><i class="bi bi-geo-alt me-1"></i>{{ investment.location }}</span>
                </div>
                
                <h5 class="fw-bold text-dark mb-3 text-truncate-2" style="height: 3rem; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;">
                    {{ investment.name }}
                </h5>

                <div class="row g-2 mb-4">
                    <div class="col-6">
                        <div class="p-2 rounded-3 bg-light text-center border border-white">
                            <small class="text-muted d-block" style="font-size: 0.6rem;">RENDEMENT</small>
                            <span class="fw-bold text-success">{{ investment.annualReturn }}%</span>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-2 rounded-3 bg-light text-center border border-white">
                            <small class="text-muted d-block" style="font-size: 0.6rem;">VALEUR</small>
                            <span class="fw-bold text-dark">{{ investment.estimatedValue|format_currency }}</span>
                        </div>
                    </div>
                </div>

                <!-- Progress -->
                <div class="mb-4">
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-muted fw-bold" style="font-size: 0.65rem;">FINANCEMENT</span>
                        <span class="fw-bold text-primary" style="font-size: 0.65rem; color: #7c3aed !important;">{{ investment.fundingPercentage|default(0) }}%</span>
                    </div>
                    <div class="progress" style="height: 6px; border-radius: 10px; background: #f1f5f9;">
                        <div class="progress-bar" style="width: {{ investment.fundingPercentage|default(0) }}%; background: linear-gradient(90deg, #7c3aed 0%, #4338ca 100%);"></div>
                    </div>
                </div>

                <!-- Action -->
                <div class="mt-auto">
                    <a href="{{ path('app_investment_show', {id: investment.id}) }}" class="btn btn-primary w-100 rounded-pill py-2 fw-bold shadow-sm" style="background: #7c3aed; border: none; font-size: 0.85rem;">
                        Consulter l'offre
                    </a>
                </div>
            </div>
        </div>
    </div>
{% else %}
    <div class="col-12 text-center py-5">
        <i class="bi bi-search display-1 text-muted"></i>
        <h5 class="mt-3">Aucun investissement trouvé pour ces critères.</h5>
    </div>
    {% endfor %}

    <div class="col-12 d-flex justify-content-center mt-4">
        {{ knp_pagination_render(investments) }}
    </div>
</div>
