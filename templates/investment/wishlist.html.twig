{% extends 'base.html.twig' %}

{% block title %}Finora - Ma Wishlist Investissements{% endblock %}

{% block body %}

<!-- 📁 Premium Wishlist Hero -->
<section class="py-5 mb-5 position-relative overflow-hidden" style="background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 100%); border-radius: 0 0 50px 50px; margin-top: -24px; margin-left: -12px; margin-right: -12px;">
    <div class="container position-relative z-1">
        <div class="row align-items-center">
            <div class="col-lg-8 text-white">
                <nav aria-label="breadcrumb" class="mb-3">
                    <ol class="breadcrumb mb-0">
                        <li class="breadcrumb-item"><a href="{{ path('app_home') }}" class="text-white-50 text-decoration-none">Finora</a></li>
                        <li class="breadcrumb-item active text-white" aria-current="page">Ma Wishlist</li>
                    </ol>
                </nav>
                <div class="d-flex align-items-center mb-3">
                    <div class="p-2 bg-white bg-opacity-10 rounded-circle me-3 border border-white border-opacity-10">
                        <i class="bi bi-heart-fill text-white fs-5"></i>
                    </div>
                    <span class="text-uppercase fw-bold text-white-50 small" style="letter-spacing: 2px; font-size: 0.7rem;">Sélection Personnalisée</span>
                </div>
                <h1 class="display-4 fw-black text-white mb-2" style="letter-spacing: -2px;">Ma <span class="text-primary-light" style="color: #a78bfa !important;">Wishlist</span></h1>
                <p class="text-white-50 mb-0 opacity-75">Retrouvez les opportunités qui ont retenu votre attention.</p>
            </div>
            <div class="col-lg-4 d-none d-lg-block text-end">
                <div class="bg-white bg-opacity-10 p-4 rounded-circle d-inline-flex align-items-center justify-content-center border border-white border-opacity-10" style="width: 140px; height: 140px;">
                    <i class="bi bi-bookmark-heart text-white display-4"></i>
                </div>
            </div>
        </div>
    </div>
</section>

    <section class="py-5">
        <div class="container">
            <div id="wishlist-container">
                {% if wishlists|length > 0 %}
                    <div class="row g-4">
                        {% for w in wishlists %}
                            {% set inv = w.investment %}
                            <div class="col-md-6 col-xl-4 wishlist-item-wrapper" id="wishlist-item-{{ inv.id }}">
                                <div class="card border-0 h-100 overflow-hidden shadow-sm" style="border-radius: 20px; transition: all 0.3s ease;">
                                    <div class="position-relative">
                                        <img src="{{ investment_image_src(inv) ?: asset('assets/images/courses/4by3/06.jpg') }}"
                                             class="card-img-top" alt="{{ inv.name }}" style="height: 200px; object-fit: cover;">
                                        <button class="wishlist-remove-btn position-absolute top-0 end-0 m-3 btn btn-white btn-round shadow-sm"
                                                data-id="{{ inv.id }}"
                                                style="border-radius: 50%; width: 35px; height: 35px; background: rgba(255,255,255,0.9); padding: 0; display: flex; align-items: center; justify-content: center; border: none;">
                                            <i class="bi bi-x-lg text-danger"></i>
                                        </button>
                                        <div class="position-absolute bottom-0 start-0 p-3 w-100" style="background: linear-gradient(to top, rgba(0,0,0,0.7), transparent);">
                                            <span class="badge bg-white text-primary rounded-pill px-3">{{ inv.category }}</span>
                                        </div>
                                    </div>
                                    <div class="card-body d-flex flex-column p-4">
                                        <h5 class="card-title fw-bold mb-2">{{ inv.name }}</h5>
                                        <p class="text-muted small mb-1">
                                            <i class="bi bi-geo-alt me-1"></i>{{ inv.location }}
                                        </p>
                                        <p class="text-muted small mb-4 flex-grow-1">
                                            {{ inv.description ? inv.description|slice(0, 100) ~ '...' : 'Aucune description disponible.' }}
                                        </p>
                                        <div class="d-flex justify-content-between align-items-center p-3 rounded-3 mb-3" style="background: #f5f3ff;">
                                            <div class="text-center">
                                                <span class="d-block text-muted small">Rendement</span>
                                                <span class="fw-bold text-success">{{ inv.annualReturn }}%</span>
                                            </div>
                                            <div class="text-center">
                                                <span class="d-block text-muted small">Objectif</span>
                                                <span class="fw-bold text-dark">{{ inv.estimatedValue|format_currency }}</span>
                                            </div>
                                            <div class="text-center">
                                                <span class="d-block text-muted small">Risque</span>
                                                <span class="fw-bold" style="color: #7c3aed;">{{ inv.riskLevel }}</span>
                                            </div>
                                        </div>
                                        <div class="d-flex justify-content-between align-items-center mt-auto pt-3 border-top">
                                            <span class="fw-bold text-dark small">Ajouté le {{ w.createdAt|date('d/m/Y') }}</span>
                                            <a href="{{ path('app_investment_show', {'id': inv.id}) }}" class="btn btn-primary btn-sm rounded-pill px-4">
                                                Voir le projet
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% else %}
                    <div class="text-center py-5">
                        <div class="mb-4">
                            <i class="bi bi-heart-break display-1 text-light"></i>
                        </div>
                        <h3 class="fw-bold">Votre wishlist est vide</h3>
                        <p class="text-muted mb-4">Explorez nos opportunités d'investissement et ajoutez celles qui vous intéressent à vos favoris.</p>
                        <a href="{{ path('app_investment_index') }}" class="btn btn-primary px-5 py-3 rounded-pill fw-bold">
                            Découvrir les investissements
                        </a>
                    </div>
                {% endif %}
            </div>
        </div>
    </section>
</main>

<style>
    .wishlist-item-wrapper {
        transition: all 0.5s ease;
    }
    .wishlist-item-wrapper.fade-out {
        opacity: 0;
        transform: scale(0.9);
    }
    .card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 30px rgba(124, 58, 237, 0.15) !important;
    }
</style>

<script>
    document.addEventListener('click', async function(e) {
        const btn = e.target.closest('.wishlist-remove-btn');
        if (!btn) return;

        const id = btn.getAttribute('data-id');
        const wrapper = document.getElementById(`wishlist-item-${id}`);

        if (confirm('Voulez-vous retirer cet investissement de votre wishlist ?')) {
            try {
                const response = await fetch(`/api/investment-wishlist/toggle/${id}`, {
                    method: 'POST',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });
                const data = await response.json();

                if (data.status === 'removed') {
                    wrapper.classList.add('fade-out');
                    setTimeout(() => {
                        wrapper.remove();
                        if (document.querySelectorAll('.wishlist-item-wrapper').length === 0) {
                            location.reload();
                        }
                    }, 500);
                }
            } catch (err) {
                console.error('Error removing from wishlist:', err);
            }
        }
    });
</script>
{% endblock %}
