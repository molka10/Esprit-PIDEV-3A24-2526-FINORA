{% extends 'base.html.twig' %}

{% block title %}Modifier mon Profil — FINORA{% endblock %}

{% block body %}
<div class="container py-5">
<div class="row justify-content-center">

    <div class="col-lg-8 col-xl-6">
        <div class="card border-0 shadow-sm" style="border-radius: 20px; overflow: hidden;">
            <div class="card-header p-4 text-white" style="background: linear-gradient(135deg, #1e1b4b 0%, #2d1b69 100%);">
                <div class="d-flex align-items-center gap-3">
                    <div style="background: rgba(255,255,255,0.1); width:48px; height:48px; border-radius:12px; display:flex; align-items:center; justify-content:center;">
                        <i class="bi bi-person-gear fs-4"></i>
                    </div>
                    <div>
                        <h4 class="mb-0 text-white">Modifier mon Profil</h4>
                        <p class="mb-0 opacity-75 small text-white">Mettez à jour vos informations personnelles.</p>
                    </div>
                </div>
            </div>
            
            <div class="card-body p-4">
                {{ form_start(form, {'attr': {'novalidate': 'novalidate', 'class': 'row g-3'}}) }}

                    <div class="col-12">
                        {{ form_errors(form) }}
                    </div>

                    <div class="col-md-6 mb-3">
                        {{ form_label(form.username, 'Nom d\'utilisateur', {'label_attr': {'class': 'form-label fw-bold small text-uppercase text-muted'}}) }}
                        {{ form_widget(form.username, {'attr': {'class': 'form-control border-light-subtle bg-light-subtle', 'placeholder': 'Votre pseudo'}}) }}
                        {{ form_errors(form.username) }}
                    </div>

                    <div class="col-md-6 mb-3">
                        {{ form_label(form.email, 'Adresse Email', {'label_attr': {'class': 'form-label fw-bold small text-uppercase text-muted'}}) }}
                        {{ form_widget(form.email, {'attr': {'class': 'form-control border-light-subtle bg-light-subtle', 'placeholder': 'exemple@mail.com'}}) }}
                        {{ form_errors(form.email) }}
                    </div>

                    <div class="col-12 mb-3">
                        {{ form_label(form.password, 'Nouveau Mot de passe', {'label_attr': {'class': 'form-label fw-bold small text-uppercase text-muted'}}) }}
                        {{ form_widget(form.password, {'attr': {'class': 'form-control border-light-subtle bg-light-subtle', 'placeholder': 'Laissez vide pour ne pas changer'}}) }}
                        <small class="text-muted">Laissez vide si vous ne souhaitez pas modifier votre mot de passe.</small>
                        {{ form_errors(form.password) }}
                    </div>
                    
                    <div class="col-12 mb-3                        <label class="form-label fw-bold small text-uppercase text-muted">Photo de profil</label>
                        <div class="d-flex align-items-center gap-4 p-3 border rounded-3 bg-light-subtle">
                            <div class="position-relative">
                                {% if app.user.image %}
                                    <img id="avatarPreview" src="{{ asset('uploads/' ~ app.user.image) }}" width="80" height="80" class="rounded-circle shadow-sm border border-2 border-white object-fit-cover">
                                {% else %}
                                    <div id="avatarPlaceholder" class="bg-primary bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
                                        <i class="bi bi-person text-primary fs-3"></i>
                                    </div>
                                    <img id="avatarPreview" src="" width="80" height="80" class="rounded-circle shadow-sm border border-2 border-white object-fit-cover d-none">
                                {% endif %}
                                <span class="position-absolute bottom-0 end-0 bg-primary text-white p-1 rounded-circle" style="line-height:0; cursor: pointer;" onclick="document.querySelector('input[type=file]').click()"><i class="bi bi-camera" style="font-size:10px;"></i></span>
                            </div>
                            <div class="flex-grow-1">
                                {{ form_widget(form.image, {'attr': {'class': 'form-control form-control-sm mb-2', 'onchange': 'previewImage(this)'}}) }}
                                <div class="d-flex gap-2 align-items-center">
                                    <small class="text-muted">Format recommandé: Carré (JPG, PNG)</small>
                                    <span class="badge bg-primary bg-opacity-10 text-primary cursor-pointer" style="cursor: pointer;" data-bs-toggle="modal" data-bs-target="#aiAvatarModal">
                                        <i class="bi bi-robot me-1"></i> Générer par IA
                                    </span>
                                </div>
                            </div>
                        </div>
                        {{ form_errors(form.image) }}
                    </div>

                    <div class="col-md-6 mb-3">
                        {{ form_label(form.phone, 'Téléphone', {'label_attr': {'class': 'form-label fw-bold small text-uppercase text-muted'}}) }}
                        {{ form_widget(form.phone, {'attr': {'class': 'form-control border-light-subtle bg-light-subtle'}}) }}
                        {{ form_errors(form.phone) }}
                    </div>

                    <div class="col-md-6 mb-3">
                        {{ form_label(form.date_of_birth, 'Date de naissance', {'label_attr': {'class': 'form-label fw-bold small text-uppercase text-muted'}}) }}
                        {{ form_widget(form.date_of_birth, {'attr': {'class': 'form-control border-light-subtle bg-light-subtle'}}) }}
                        {{ form_errors(form.date_of_birth) }}
                    </div>

                    <div class="col-12 mb-4">
                        {{ form_label(form.address, 'Adresse complète', {'label_attr': {'class': 'form-label fw-bold small text-uppercase text-muted'}}) }}
                        {{ form_widget(form.address, {'attr': {'class': 'form-control border-light-subtle bg-light-subtle', 'rows': '2'}}) }}
                        {{ form_errors(form.address) }}
                    </div>

                    {# Hidden or restricted fields if any #}
                    <div class="d-none">
                         {{ form_row(form.role) }}
                        {% if form.isVerified is defined %}{{ form_row(form.isVerified) }}{% endif %}
                    </div>

                    <div class="col-12 mt-4">
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary btn-lg px-5 fw-bold" style="border-radius:12px;">
                                Enregistrer les modifications
                            </button>
                            <a href="{{ path('app_profile') }}" class="btn btn-light btn-lg px-4 text-muted border" style="border-radius:12px;">
                                Annuler
                            </a>
                        </div>
                    </div>

                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>

<!-- AI Avatar Modal -->
<div class="modal fade" id="aiAvatarModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 25px;">
            <div class="modal-header border-0 p-4 pb-0">
                <h5 class="fw-bold"><i class="bi bi-robot text-primary me-2"></i>Générateur d'Avatar IA</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4 text-center">
                <p class="text-muted small">L'intelligence artificielle de Finora va vous proposer un avatar unique.</p>
                
                <div class="mb-4 p-3 bg-light rounded-4 d-inline-block">
                    <img id="aiPreviewImg" src="https://api.dicebear.com/7.x/avataaars/svg?seed=FinoraUser" 
                         class="rounded-circle shadow" style="width: 120px; height: 120px; background: white;">
                </div>

                <div class="mb-4 text-start">
                    <label class="form-label small fw-bold text-uppercase text-muted">Choisissez un univers</label>
                    <div class="row g-2">
                        <div class="col-6">
                            <button type="button" class="btn btn-light w-100 py-2 style-btn active" data-style="avataaars">Professionnel</button>
                        </div>
                        <div class="col-6">
                            <button type="button" class="btn btn-light w-100 py-2 style-btn" data-style="bottts">Robotique</button>
                        </div>
                        <div class="col-6">
                            <button type="button" class="btn btn-light w-100 py-2 style-btn" data-style="adventurer">Aventurier</button>
                        </div>
                        <div class="col-6">
                            <button type="button" class="btn btn-light w-100 py-2 style-btn" data-style="fun-emoji">Fun Emoji</button>
                        </div>
                    </div>
                </div>

                <div class="d-grid gap-2">
                    <button type="button" id="btnRegenerate" class="btn btn-outline-primary rounded-pill py-2">
                        <i class="bi bi-arrow-clockwise me-2"></i>Changer d'avatar
                    </button>
                    <button type="button" id="btnApplyAiAvatar" class="btn btn-primary rounded-pill py-2">
                        <i class="bi bi-check2-circle me-2"></i>Utiliser cet avatar
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
function previewImage(input) {
    if (input.files && input.files[0]) {
        var reader = new FileReader();
        reader.onload = function(e) {
            const preview = document.getElementById('avatarPreview');
            const placeholder = document.getElementById('avatarPlaceholder');
            if (placeholder) placeholder.classList.add('d-none');
            preview.classList.remove('d-none');
            preview.src = e.target.result;
        }
        reader.readAsDataURL(input.files[0]);
    }
}

document.addEventListener('DOMContentLoaded', function() {
    const aiPreviewImg = document.getElementById('aiPreviewImg');
    const btnRegenerate = document.getElementById('btnRegenerate');
    const btnApplyAiAvatar = document.getElementById('btnApplyAiAvatar');
    let currentStyle = 'avataaars';

    document.querySelectorAll('.style-btn').forEach(btn => {
        btn.addEventListener('click', function() {
            document.querySelectorAll('.style-btn').forEach(b => b.classList.remove('active', 'btn-primary'));
            document.querySelectorAll('.style-btn').forEach(b => b.classList.add('btn-light'));
            this.classList.remove('btn-light');
            this.classList.add('active', 'btn-primary');
            currentStyle = this.dataset.style;
            updateAiAvatar();
        });
    });

    function updateAiAvatar() {
        const seed = Math.random().toString(36).substring(7);
        aiPreviewImg.src = `https://api.dicebear.com/7.x/${currentStyle}/svg?seed=${seed}`;
    }

    btnRegenerate.addEventListener('click', updateAiAvatar);

    btnApplyAiAvatar.addEventListener('click', function() {
        const avatarUrl = aiPreviewImg.src;
        
        Swal.fire({
            title: 'Génération...',
            allowOutsideClick: false,
            didOpen: () => { Swal.showLoading(); }
        });

        fetch(avatarUrl)
            .then(res => res.blob())
            .then(blob => {
                const file = new File([blob], "ai-avatar.svg", { type: "image/svg+xml" });
                const dataTransfer = new DataTransfer();
                dataTransfer.items.add(file);
                const fileInput = document.querySelector('input[type="file"]');
                fileInput.files = dataTransfer.files;
                
                const preview = document.getElementById('avatarPreview');
                const placeholder = document.getElementById('avatarPlaceholder');
                if (placeholder) placeholder.classList.add('d-none');
                preview.classList.remove('d-none');
                preview.src = avatarUrl;

                Swal.fire({
                    icon: 'success',
                    title: 'Avatar Prêt !',
                    text: 'Sauvegardez pour finaliser.',
                    timer: 1500,
                    showConfirmButton: false
                });

                bootstrap.Modal.getInstance(document.getElementById('aiAvatarModal')).hide();
            });
    });
});
</script>
{% endblock %}