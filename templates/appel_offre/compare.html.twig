{% extends 'base.html.twig' %}

{% block title %}Comparer les Offres — FINORA{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="mb-5 d-flex align-items-center justify-content-between">
        <div>
            <h2 class="fw-bold mb-0" style="color: #1f1147;">Comparaison des Offres</h2>
            <p class="text-muted">Analysez les opportunités côte à côte.</p>
        </div>
        <a href="{{ path('app_appel_offre_index') }}" class="btn btn-outline-primary rounded-pill px-4">
            <i class="bi bi-arrow-left me-2"></i>Retour aux offres
        </a>
    </div>

    <div class="card border-0 shadow-sm overflow-hidden" style="border-radius: 25px;">
        <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle">
                <thead class="bg-light">
                    <tr>
                        <th class="p-4 border-0" style="width: 200px;">Caractéristique</th>
                        {% for offre in offres %}
                            <th class="p-4 border-0 text-center">
                                <div class="badge bg-primary bg-opacity-10 text-primary mb-2">{{ offre.type|upper }}</div>
                                <h6 class="fw-bold mb-0">{{ offre.titre }}</h6>
                            </th>
                        {% endfor %}
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="p-4 fw-bold text-muted small text-uppercase">Budget</td>
                        {% for offre in offres %}
                            <td class="p-4 text-center">
                                <span class="h5 fw-bold text-dark">{{ offre.budgetMin|format_currency('TND') }}</span>
                                <span class="d-block text-muted small">jusqu'à {{ offre.budgetMax|format_currency('TND') }}</span>
                            </td>
                        {% endfor %}
                    </tr>
                    <tr>
                        <td class="p-4 fw-bold text-muted small text-uppercase">Catégorie</td>
                        {% for offre in offres %}
                            <td class="p-4 text-center">
                                <span class="badge rounded-pill bg-light text-dark px-3">{{ offre.categorie.nom ?? 'Non classé' }}</span>
                            </td>
                        {% endfor %}
                    </tr>
                    <tr>
                        <td class="p-4 fw-bold text-muted small text-uppercase">Date Limite</td>
                        {% for offre in offres %}
                            <td class="p-4 text-center">
                                <div class="{% if offre.dateLimite < date() %}text-danger{% else %}text-success{% endif %} fw-bold">
                                    <i class="bi bi-calendar-event me-2"></i>
                                    {{ offre.dateLimite|date('d M Y') }}
                                </div>
                                <small class="text-muted">Il reste {{ offre.dateLimite.diff(date()).days }} jours</small>
                            </td>
                        {% endfor %}
                    </tr>
                    <tr>
                        <td class="p-4 fw-bold text-muted small text-uppercase">Description</td>
                        {% for offre in offres %}
                            <td class="p-4">
                                <p class="small text-muted mb-0" style="max-width: 300px;">
                                    {{ offre.description|slice(0, 150) }}...
                                </p>
                            </td>
                        {% endfor %}
                    </tr>
                    <tr>
                        <td class="p-4"></td>
                        {% for offre in offres %}
                            <td class="p-4 text-center">
                                <a href="{{ path('app_appel_offre_show', {'id': offre.id}) }}" class="btn btn-primary rounded-pill px-4 shadow-sm">
                                    Voir Détails
                                </a>
                            </td>
                        {% endfor %}
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- AI Insight -->
    <div class="mt-5 p-4 bg-primary bg-opacity-10 rounded-4 border border-primary border-opacity-10">
        <div class="d-flex align-items-center gap-3">
            <div class="bg-primary p-3 rounded-circle text-white shadow-sm">
                <i class="bi bi-robot fs-4"></i>
            </div>
            <div>
                <h5 class="fw-bold text-primary mb-1">Analyse Comparative par IA</h5>
                <p class="text-primary mb-0 opacity-75">
                    Basé sur votre profil, l'offre <strong>"{{ offres|first.titre }}"</strong> semble offrir le meilleur rapport budget/délai pour vos compétences actuelles.
                </p>
            </div>
        </div>
    </div>
</div>
{% endblock %}
