{% extends 'base.html.twig' %}

{% block title %}Vérification 2FA - FINORA{% endblock %}

{% block body %}
<section class="p-0 d-flex align-items-center position-relative overflow-hidden" style="min-height: 80vh;">
    <div class="container-fluid h-100">
        <div class="row g-0 justify-content-center h-100">
            <div class="col-md-8 col-lg-6 col-xl-4 py-5 px-sm-5">
                <div class="card shadow-lg border-0 p-4 p-sm-5" style="border-radius: 24px; background: rgba(255, 255, 255, 0.9); backdrop-filter: blur(10px);">
                    <div class="text-center mb-4">
                        <div class="icon-lg bg-primary bg-opacity-10 text-primary rounded-circle mx-auto mb-3 d-flex align-items-center justify-content-center" style="width: 70px; height: 70px;">
                            <i class="bi bi-shield-lock-fill fs-1"></i>
                        </div>
                        <h2 class="h3 fw-bold">Vérification de sécurité</h2>
                        <p class="text-muted small">Pour protéger votre compte, nous avons envoyé un code de vérification à 6 chiffres à votre adresse email.</p>
                    </div>

                    {% for label, messages in app.flashes %}
                        {% for message in messages %}
                            <div class="alert alert-{{ label }} alert-dismissible fade show rounded-3 mb-4" role="alert">
                                {{ message }}
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                            </div>
                        {% endfor %}
                    {% endfor %}

                    <form method="POST">
                        <div class="mb-4">
                            <label for="otp" class="form-label fw-bold">Code de vérification</label>
                            <input type="text" name="otp" id="otp" class="form-control form-control-lg text-center fw-bold letter-spacing-2" placeholder="000000" maxlength="6" required autofocus style="border-radius: 12px; height: 60px; font-size: 24px;">
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg shadow-sm" style="border-radius: 12px; height: 55px; background: var(--finora-gradient);">
                                Vérifier le code <i class="bi bi-arrow-right ms-2"></i>
                            </button>
                        </div>
                    </form>

                    <div class="text-center mt-4">
                        <p class="mb-0 small">Vous n'avez pas reçu le code ? 
                            <a href="{{ path('app_2fa_resend') }}" class="text-primary fw-bold">Renvoyer le code</a>
                        </p>
                        <a href="{{ path('app_logout') }}" class="text-muted small d-block mt-3">Retour à la connexion</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .letter-spacing-2 {
        letter-spacing: 0.5rem;
    }
</style>
{% endblock %}
